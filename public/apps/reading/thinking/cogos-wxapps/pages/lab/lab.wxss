/* ===== 舞台：深墨仪器舱 ===== */
.stage{position:relative;height:660rpx;border-radius:24rpx;overflow:hidden;
  background:radial-gradient(120% 90% at 50% 18%, #14262E, #0F1D24 68%);
  border:2rpx solid #0A141A;box-shadow:0 30rpx 60rpx -34rpx rgba(15,29,36,.75);
  margin-bottom:18rpx;}
.world{position:absolute;left:0;right:0;top:0;bottom:0;transition:transform .8s ease;transform-origin:50% 52%;}
.hud{position:absolute;left:20rpx;top:16rpx;z-index:9;font-size:20rpx;color:rgba(240,229,205,.75);
  background:rgba(15,29,36,.6);border:1rpx solid rgba(127,209,200,.25);border-radius:10rpx;padding:6rpx 14rpx;}
.stage.shake{animation:shake .42s ease;}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-10rpx)}40%{transform:translateX(9rpx)}60%{transform:translateX(-7rpx)}80%{transform:translateX(5rpx)}}
.fadein{animation:fadein .8s ease both;}
@keyframes fadein{from{opacity:0}to{opacity:1}}
.pop{animation:pop .5s cubic-bezier(.2,1.6,.4,1) both;}
@keyframes pop{from{transform:scale(.3);opacity:0}to{transform:scale(1);opacity:1}}
.rise{animation:rise .6s ease both;}
@keyframes rise{from{transform:translateY(30rpx);opacity:0}to{transform:translateY(0);opacity:1}}
.pulse{animation:pulse 2.6s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:.45}50%{opacity:.95}}
.blink{animation:blink 1.3s steps(1) infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
.march{background-image:linear-gradient(90deg, rgba(210,105,63,.9) 55%, transparent 45%);
  background-size:22rpx 100%;animation:march 1.1s linear infinite;}
@keyframes march{to{background-position:22rpx 0}}
.floaty{animation:floaty 5.5s ease-in-out infinite;}
.floaty.f1{animation-duration:6.4s;animation-delay:.6s}
.floaty.f2{animation-duration:7.2s;animation-delay:1.1s}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-14rpx)}}

/* 飞行粒子 */
.flychip{position:absolute;width:26rpx;height:26rpx;border-radius:50%;z-index:8;}
.flychip.on{transition:left .8s ease, top .8s ease;}
.flychip.wob{animation:wob .5s ease-in-out infinite;}
@keyframes wob{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}

/* ===== 序 ===== */
.driftw{position:absolute;color:rgba(240,229,205,.16);font-size:26rpx;animation:drift 7s ease-in-out infinite;}
.driftw.d2{animation-duration:9s;animation-delay:1s}
.driftw.d3{animation-duration:11s;animation-delay:2s}
@keyframes drift{0%,100%{transform:translate(0,0)}50%{transform:translate(16rpx,-20rpx)}}
.cut-ring{position:absolute;left:50%;top:50%;width:380rpx;height:380rpx;margin:-190rpx 0 0 -190rpx;
  border-radius:50%;border:5rpx solid #7FD1C8;opacity:0;transform:scale(.2) rotate(-90deg);
  transition:all 1.4s ease;}
.cut-ring.on{opacity:1;transform:scale(1) rotate(0);background:rgba(127,209,200,.06);}
.cutA{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);
  color:#7FD1C8;font-size:72rpx;font-weight:700;}
.cutAs{position:absolute;left:50%;top:58%;transform:translateX(-50%);
  color:rgba(127,209,200,.6);font-size:22rpx;}
.cutNA{position:absolute;right:6%;top:12%;color:rgba(210,105,63,.85);font-size:46rpx;font-weight:700;}
.cutNAs{position:absolute;right:6%;top:22%;color:rgba(210,105,63,.55);font-size:21rpx;}

/* ===== 1.0 ===== */
.c-ring{position:absolute;left:50%;top:46%;width:430rpx;height:430rpx;margin:-215rpx 0 0 -215rpx;
  border-radius:50%;border:6rpx solid #7FD1C8;background:rgba(127,209,200,.05);
  transition:all .7s ease;}
.c-ring.bad{border-color:#D2693F;animation:flick .8s steps(2) infinite;}
@keyframes flick{50%{opacity:.55}}
.c-ring.gone,.c-port.gone{opacity:0;transform:scale(1.4);transition:all .85s ease;}
.c-inner{position:absolute;left:16%;right:16%;top:16%;bottom:16%;border-radius:50%;border:2rpx dashed rgba(127,209,200,.28);}
.c-dot{position:absolute;width:14rpx;height:14rpx;margin:-7rpx;border-radius:50%;background:#7FD1C8;}
.c-port{position:absolute;right:4%;top:44%;width:26rpx;height:56rpx;border-radius:8rpx;
  background:#1F6E6B;border:2rpx solid #7FD1C8;}
.c-portlbl{position:absolute;right:3%;top:55%;font-size:19rpx;color:rgba(240,229,205,.5);}
.thm{position:absolute;padding:6rpx 16rpx;border-radius:999rpx;font-size:20rpx;
  background:rgba(127,209,200,.16);border:2rpx solid rgba(127,209,200,.6);color:#F0E5CD;}
.crack{position:absolute;width:70rpx;height:5rpx;background:#D2693F;border-radius:4rpx;}
.fatal{position:absolute;left:0;right:0;top:8%;text-align:center;color:#D2693F;
  font-size:28rpx;font-weight:700;}
.c-cap{position:absolute;left:0;right:0;bottom:5%;text-align:center;
  color:rgba(240,229,205,.55);font-size:21rpx;}

/* ===== 2.0 ===== */
.d-flux{position:absolute;left:0;right:0;text-align:center;color:rgba(210,105,63,.7);font-size:21rpx;}
.d-flux.top{top:4%}.d-flux.bot{bottom:3%}
.d-band{position:absolute;left:3%;top:42%;color:rgba(240,229,205,.42);font-size:19rpx;
  writing-mode:vertical-lr;letter-spacing:.2em;}
.d-trail{position:absolute;left:12%;right:6%;top:12%;display:flex;flex-direction:column;gap:10rpx;}
.d-lv{font-size:20rpx;color:rgba(201,154,58,.85);border-left:4rpx dashed rgba(201,154,58,.5);
  padding:4rpx 0 4rpx 16rpx;}
.d-pair{position:absolute;left:0;right:0;bottom:12%;display:flex;align-items:center;
  justify-content:center;gap:0;transition:opacity .8s;}
.d-pair.merge .node.teal,.d-pair.merge .node.terra,.d-pair.merge .tension{opacity:0;transform:scale(.4);transition:all .75s ease;}
.node{width:150rpx;height:150rpx;border-radius:50%;display:flex;flex-direction:column;
  align-items:center;justify-content:center;border:4rpx solid;}
.node .n1{font-size:32rpx;font-weight:700;color:#F0E5CD;}
.node .n2{font-size:19rpx;color:rgba(240,229,205,.7);}
.node.teal{background:rgba(42,127,122,.28);border-color:#7FD1C8;}
.node.terra{background:rgba(192,91,51,.3);border-color:#D2693F;}
.node.gold{background:rgba(176,138,46,.3);border-color:#C99A3A;position:absolute;bottom:130rpx;}
.node.osc{animation:osc 1.2s ease-in-out infinite;}
.node.osc2{animation:osc 1.2s ease-in-out infinite reverse;}
@keyframes osc{0%,100%{transform:translateY(0)}50%{transform:translateY(-10rpx)}}
.tension{width:110rpx;height:5rpx;margin:0 8rpx;}

/* ===== 3.0 ===== */
.r-hist{position:absolute;left:0;right:0;top:5%;text-align:center;
  color:rgba(240,229,205,.5);font-size:18rpx;}
.r-orb{position:absolute;left:50%;top:32%;width:320rpx;height:320rpx;margin:-160rpx 0 0 -160rpx;
  border-radius:50%;border:4rpx solid #7FD1C8;background:rgba(127,209,200,.05);}
.r-sat{position:absolute;width:9rpx;height:9rpx;border-radius:50%;background:rgba(127,209,200,.45);}
.r-loop{position:absolute;right:5%;top:9%;color:#D2693F;font-size:24rpx;font-weight:700;}
.r-liar{position:absolute;left:50%;top:30%;transform:translateX(-50%);display:flex;align-items:center;gap:14rpx;
  background:rgba(15,29,36,.92);border:3rpx solid #D2693F;border-radius:14rpx;
  padding:14rpx 22rpx;color:#F0E5CD;font-size:27rpx;z-index:5;}
.r-badge{width:56rpx;height:56rpx;border-radius:50%;background:#2A7F7A;color:#0F1D24;
  display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;
  transition:background .15s;}
.r-badge.f{background:#C05B33;}
.r-ashby{position:absolute;left:5%;right:5%;top:56%;font-size:20rpx;color:rgba(240,229,205,.75);}
.r-al{font-weight:700;color:#F0E5CD;margin-bottom:8rpx;font-size:21rpx;}
.r-row{display:flex;align-items:center;margin-bottom:8rpx;}
.r-rl{width:250rpx;font-size:18rpx;}
.r-bar{height:16rpx;border-radius:8rpx;transition:width .6s ease;}
.r-bar.t{background:#2A7F7A;}
.r-bar.r{background:#C05B33;}
.r-gap{color:#D2693F;font-size:19rpx;margin-left:10rpx;}
.r-trip{position:absolute;left:5%;right:5%;bottom:3%;display:flex;gap:12rpx;}
.r-card{flex:1;background:rgba(127,160,188,.16);border:2rpx solid #5D7B93;border-radius:12rpx;
  padding:10rpx 8rpx;display:flex;flex-direction:column;align-items:center;text-align:center;}
.rc1{color:#F0E5CD;font-size:21rpx;font-weight:700;}
.rc2{color:rgba(240,229,205,.65);font-size:16rpx;}

/* ===== 3.0⁺ ===== */
.tw-stack{position:absolute;left:0;right:0;bottom:6%;display:flex;
  flex-direction:column-reverse;align-items:center;gap:14rpx;}
.tw-slab{position:relative;height:90rpx;border-radius:14rpx;background:rgba(127,160,188,.16);
  border:2rpx solid #5D7B93;display:flex;align-items:center;padding:0 26rpx;}
.tw-l{color:#F0E5CD;font-size:26rpx;font-weight:700;margin-right:18rpx;}
.tw-tag{color:rgba(240,229,205,.6);font-size:19rpx;}
.tw-blind{position:absolute;left:-10rpx;top:50%;width:20rpx;height:20rpx;margin-top:-10rpx;
  background:#0F1D24;border:2rpx solid #D2693F;transform:rotate(45deg);}
.tw-chip{position:absolute;right:6%;padding:8rpx 20rpx;border-radius:999rpx;background:#C05B33;
  color:#0F1D24;font-size:20rpx;font-weight:700;transition:bottom .7s ease;z-index:5;}
.tw-note{position:absolute;left:4%;top:34%;color:rgba(210,105,63,.85);font-size:19rpx;width:150rpx;}
.tw-inf{position:absolute;left:0;right:0;top:5%;text-align:center;color:rgba(240,229,205,.65);
  font-size:22rpx;display:flex;flex-direction:column;align-items:center;}
.tw-dots{font-size:34rpx;color:#F0E5CD;}

/* ===== 4.0 ===== */
.bub{position:absolute;border-radius:50%;display:flex;flex-direction:column;align-items:center;
  justify-content:center;border:2rpx solid rgba(240,229,205,.35);text-align:center;padding:8rpx;}
.bub.sel{border-color:#C99A3A;border-width:3rpx;}
.bub .b1{color:#F0E5CD;font-size:22rpx;font-weight:700;}
.bub .b2{color:rgba(240,229,205,.62);font-size:15rpx;}
.g0{background:radial-gradient(circle at 50% 42%, rgba(42,127,122,.4), rgba(42,127,122,.06) 72%);}
.g1{background:radial-gradient(circle at 50% 42%, rgba(127,160,188,.4), rgba(127,160,188,.06) 72%);}
.g2{background:radial-gradient(circle at 50% 42%, rgba(210,105,63,.38), rgba(210,105,63,.06) 72%);}
.g3{background:radial-gradient(circle at 50% 42%, rgba(201,154,58,.4), rgba(201,154,58,.06) 72%);}
.g4{background:radial-gradient(circle at 50% 42%, rgba(127,209,200,.36), rgba(127,209,200,.06) 72%);}
.g5{background:radial-gradient(circle at 50% 42%, rgba(139,131,120,.4), rgba(139,131,120,.06) 72%);}
.tdot{position:absolute;bottom:26rpx;left:50%;width:22rpx;height:22rpx;margin-left:-11rpx;border-radius:50%;}
.tdot.t{background:#2A7F7A;}
.tdot.r{background:#C05B33;}
.tp{position:absolute;bottom:2rpx;left:0;right:0;color:#F0E5CD;font-size:16rpx;}
.bub.quar{border-color:#D2693F;}
.quar-ring{position:absolute;left:-10rpx;right:-10rpx;top:-10rpx;bottom:-10rpx;border-radius:50%;border:3rpx solid #D2693F;
  animation:qring 1.4s ease-out infinite;}
@keyframes qring{from{transform:scale(.85);opacity:1}to{transform:scale(1.18);opacity:0}}
.quar-t{position:absolute;top:-34rpx;left:0;right:0;color:#D2693F;font-size:19rpx;}
.eco-foot{position:absolute;left:5%;bottom:3%;display:flex;gap:26rpx;font-size:21rpx;}
.ef-bad{color:#D2693F;}
.ef-ok{color:#7FD1C8;}

/* ===== ∞ ===== */
.mi-cap{position:absolute;left:0;right:0;top:20%;text-align:center;
  color:rgba(240,229,205,.5);font-size:22rpx;}
.mi-row{position:absolute;left:4%;right:4%;top:38%;display:flex;align-items:center;
  justify-content:space-between;}
.mi-item{display:flex;flex-direction:column;align-items:center;gap:10rpx;
  color:rgba(240,229,205,.6);font-size:17rpx;}
.mi-arr{color:rgba(240,229,205,.4);font-size:22rpx;}
.mi-ic{width:78rpx;height:78rpx;display:flex;align-items:center;justify-content:center;}
.mi-ic.ring{border:4rpx solid #7FD1C8;border-radius:50%;}
.mi-ic.spiral{border:4rpx solid #C99A3A;border-radius:50%;color:#C99A3A;font-size:34rpx;transform:rotate(20deg);}
.mi-ic.slabs{flex-direction:column;gap:6rpx;}
.mi-ic.slabs view{height:12rpx;background:rgba(127,160,188,.6);border-radius:4rpx;}
.mi-ic.slabs view:nth-child(1){width:64rpx}
.mi-ic.slabs view:nth-child(2){width:48rpx}
.mi-ic.slabs view:nth-child(3){width:34rpx}
.mi-ic.eco{gap:6rpx;}
.mi-ic.eco view{border-radius:50%;background:radial-gradient(circle,rgba(127,209,200,.7),rgba(127,209,200,.1));}
.mi-ic.eco view:nth-child(1){width:30rpx;height:30rpx}
.mi-ic.eco view:nth-child(2){width:22rpx;height:22rpx}
.mi-ic.eco view:nth-child(3){width:16rpx;height:16rpx}
.mi-frame{position:absolute;border:3rpx solid #7FD1C8;border-radius:28rpx;z-index:6;pointer-events:none;}
.mi-eye{position:absolute;width:52rpx;height:30rpx;border:3rpx solid #7FD1C8;border-radius:50%;
  background:#0F1D24;display:flex;align-items:center;justify-content:center;}
.mi-pupil{width:12rpx;height:12rpx;border-radius:50%;background:#7FD1C8;}
.mi-olbl{position:absolute;color:rgba(240,229,205,.8);font-size:19rpx;background:rgba(15,29,36,.75);
  padding:2rpx 10rpx;border-radius:8rpx;}
.mi-blind{position:absolute;left:50%;bottom:-9rpx;width:18rpx;height:18rpx;margin-left:-9rpx;
  background:#0F1D24;border:2rpx solid #D2693F;transform:rotate(45deg);}
.mi-blbl{position:absolute;left:6%;bottom:11%;color:rgba(210,105,63,.85);font-size:18rpx;z-index:7;}
.mi-more{position:absolute;right:4%;top:3%;color:rgba(240,229,205,.5);font-size:24rpx;z-index:7;}

/* ===== 叙述与动作 ===== */
.narrbox{background:var(--paper2);border:2rpx solid var(--hair);border-radius:22rpx;
  padding:24rpx 28rpx;margin-bottom:22rpx;font-size:26rpx;}
.actions{margin-top:16rpx;display:flex;flex-direction:column;}
.truthbox{display:flex;align-items:center;gap:14rpx;margin-top:8rpx;
  background:rgba(15,29,36,.06);border:2rpx dashed var(--hair);border-radius:16rpx;
  padding:12rpx 20rpx;font-size:24rpx;color:var(--ink2);}
.tslide{flex:1;margin:0 6rpx;}
.tv{color:var(--teal-deep);font-weight:700;}

/* ===== 侧面板（内核 / 仪表 / 日志）===== */
.spanel{background:var(--void);border-radius:22rpx;padding:22rpx 26rpx;margin-bottom:22rpx;
  color:var(--labtx);}
.sp-h{font-size:20rpx;letter-spacing:.18em;color:var(--labdim);font-weight:600;margin-bottom:14rpx;}
.kview{font-size:22rpx;color:var(--labdim);margin-bottom:12rpx;display:flex;justify-content:space-between;}
.kback{color:#C99A3A;text-decoration:underline;}
.law{display:flex;justify-content:space-between;align-items:center;border:2rpx solid rgba(240,229,205,.16);
  border-radius:14rpx;padding:12rpx 18rpx;margin-bottom:10rpx;transition:all .4s;}
.law .lw{display:flex;flex-direction:column;}
.law .lname{font-size:24rpx;font-weight:700;}
.law .lf{font-size:18rpx;color:var(--labdim);}
.law .lst{font-size:19rpx;color:var(--labdim);max-width:290rpx;text-align:right;}
.law.off{opacity:.42;}
.law.on{border-color:rgba(127,209,200,.6);}
.law.on .lst{color:#7FD1C8;}
.law.rigid{border-color:rgba(127,160,188,.65);background:rgba(127,160,188,.08);}
.law.rigid .lst{color:#7FA0BC;}
.law.engine{border-color:#C99A3A;background:rgba(201,154,58,.1);animation:engl 1.6s ease-in-out infinite;}
.law.engine .lst{color:#C99A3A;}
@keyframes engl{0%,100%{box-shadow:0 0 0 rgba(201,154,58,0)}50%{box-shadow:0 0 22rpx rgba(201,154,58,.4)}}
.law.warn{border-color:#D2693F;background:rgba(210,105,63,.1);}
.law.warn .lst{color:#D2693F;}
.law.rel{border-style:dashed;border-color:rgba(127,209,200,.5);}
.law.rel .lst{color:#7FD1C8;}
.mrow.dark .ml{color:var(--labdim);}
.mrow.dark .mv{color:#7FD1C8;}
.mrow.dark .mbar{background:rgba(240,229,205,.1);}
.mi.tcl{background:#7FD1C8;}
.mi.ttn{background:#D2693F;}
.mi.tvr{background:#C99A3A;}
.mi.ten{background:#7FA0BC;}
.syslog{height:280rpx;font-size:19rpx;line-height:1.7;}
.ln{color:var(--labdim);border-left:3rpx solid rgba(127,209,200,.25);padding-left:12rpx;margin-bottom:6rpx;}
.ln.ok{color:#9FE0D8;border-color:#7FD1C8;}
.ln.warn{color:#E0B27A;border-color:#C99A3A;}
.ln.err{color:#E88A66;border-color:#D2693F;}
