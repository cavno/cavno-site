---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/western-philosophy-history-systems-analysis/body.html?raw';
import '../../../legacy/reading/philosophy/western-philosophy-history-systems-analysis/style.css';

const meta = {
  "title": "西方哲学史的系统论分析",
  "description": "以机械系统、开放系统、信息系统、自组织、复杂适应与演化系统为主线，重构西方哲学两千六百年的问题转换与反身化进程。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp systems-history-essay">
    <Fragment set:html={body} />
  </article>
</Base>
