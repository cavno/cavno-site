---
interface Props {
  title: string;
  href: string;
  summary?: string;
  date?: Date;
  tags?: string[];
}

const { title, href, summary = '', date, tags = [] } = Astro.props;
const route = href.endsWith('/') ? href : `${href}/`;
const slug = route.split('/').filter(Boolean).at(-1) ?? 'article';
const fileBase = `${route}downloads/${slug}`;
const published = date instanceof Date ? date.toISOString().slice(0, 10) : '';
---

<div
  class="cv-article-actions-row"
  data-cv-export-route={route}
  data-cv-export-title={title}
  data-cv-export-summary={summary}
  data-cv-export-date={published}
  data-cv-export-tags={JSON.stringify(tags)}
  data-export-ignore
>
  <div class="cv-article-actions-inner">
    <div class="cv-article-actions" aria-label="文章操作">
      <button class="cv-article-copy" type="button" aria-label="复制 Markdown 正文">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
        <span>复制正文</span>
      </button>

      <div class="cv-article-download">
        <button class="cv-article-download-trigger" type="button" aria-haspopup="menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5"></path><path d="M5 19h14"></path></svg>
          <span>下载</span>
          <svg class="cv-article-download-chev" viewBox="0 0 12 12" aria-hidden="true"><path d="m2 4 4 4 4-4"></path></svg>
        </button>

        <div class="cv-article-download-menu" role="menu" hidden>
          <a href={`${fileBase}.md`} download={`${slug}.md`} role="menuitem">
            <span class="cv-file-icon" aria-hidden="true">M↓</span>
            <span><strong>Markdown 文档</strong><small>UTF-8 · 标准 Markdown</small></span>
          </a>
          <a href={`${fileBase}.pdf`} download={`${slug}.pdf`} role="menuitem">
            <span class="cv-file-icon" aria-hidden="true">PDF</span>
            <span><strong>PDF 文档</strong><small>可检索文字 · A4 分页</small></span>
          </a>
          <a href={`${fileBase}.docx`} download={`${slug}.docx`} role="menuitem">
            <span class="cv-file-icon" aria-hidden="true">W</span>
            <span><strong>Microsoft Word</strong><small>OOXML · 可继续编辑</small></span>
          </a>
        </div>
      </div>

      <span class="cv-article-action-status" role="status" aria-live="polite"></span>
    </div>
  </div>
</div>

<script>
  const copyWithFallback = async (text: string) => {
    if (navigator.clipboard?.writeText && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.appendChild(field);
    field.select();
    const copied = document.execCommand('copy');
    field.remove();
    if (!copied) throw new Error('copy failed');
  };

  document.querySelectorAll<HTMLElement>('.cv-article-actions-row').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.cv-article-download-trigger');
    const menu = root.querySelector<HTMLElement>('.cv-article-download-menu');
    const copy = root.querySelector<HTMLButtonElement>('.cv-article-copy');
    const status = root.querySelector<HTMLElement>('.cv-article-action-status');
    let statusTimer = 0;

    const report = (message: string) => {
      if (!status) return;
      window.clearTimeout(statusTimer);
      status.textContent = message;
      statusTimer = window.setTimeout(() => { status.textContent = ''; }, 2400);
    };
    const close = (restoreFocus = false) => {
      if (!menu || !trigger) return;
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };
    const open = () => {
      if (!menu || !trigger) return;
      document.querySelectorAll<HTMLElement>('.cv-article-download-menu:not([hidden])').forEach((other) => {
        if (other !== menu) other.hidden = true;
      });
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      menu.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
    };

    trigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      menu?.hidden ? open() : close();
    });
    menu?.addEventListener('click', (event) => event.stopPropagation());
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu && !menu.hidden) {
        event.preventDefault();
        close(true);
      }
    });
    document.addEventListener('click', () => close());

    copy?.addEventListener('click', async () => {
      const markdownLink = root.querySelector<HTMLAnchorElement>('a[href$=".md"]');
      if (!markdownLink) return;
      copy.disabled = true;
      try {
        const response = await fetch(markdownLink.href, { credentials: 'same-origin' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const markdown = await response.text();
        if (!markdown.trim() || markdown.includes('\uFFFD')) throw new Error('invalid markdown');
        await copyWithFallback(markdown);
        report('已复制 Markdown 正文');
      } catch {
        report('复制失败，请先生成下载文档');
      } finally {
        copy.disabled = false;
      }
    });
  });
</script>

<style>
  .cv-article-actions-row{position:relative;z-index:40;width:100%;height:0;pointer-events:none}
  .cv-article-actions-inner{display:flex;justify-content:flex-end;width:min(1180px,100%);margin:0 auto;padding:14px 24px 0}
  .cv-article-actions{position:relative;display:flex;align-items:center;gap:6px;pointer-events:auto}
  .cv-article-copy,.cv-article-download-trigger{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;padding:8px 12px;border:1px solid rgba(207,204,192,.92);border-radius:999px;background:rgba(255,255,255,.9);color:#141413;box-shadow:0 5px 18px rgba(20,20,19,.055);font:500 12.5px/1 var(--sans);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:border-color .15s,background .15s,box-shadow .15s}
  .cv-article-copy:hover,.cv-article-download-trigger:hover,.cv-article-download-trigger[aria-expanded="true"]{border-color:#8f8b80;background:#fff;box-shadow:0 8px 22px rgba(20,20,19,.09)}
  .cv-article-copy:disabled{cursor:wait;opacity:.58}
  .cv-article-copy>svg,.cv-article-download-trigger>svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .cv-article-download-trigger .cv-article-download-chev{width:10px;height:10px;transition:transform .15s}
  .cv-article-download-trigger[aria-expanded="true"] .cv-article-download-chev{transform:rotate(180deg)}
  .cv-article-download{position:relative}
  .cv-article-download-menu{position:absolute;top:calc(100% + 8px);right:0;width:254px;padding:7px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.985);box-shadow:0 18px 46px rgba(20,20,19,.15);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
  .cv-article-download-menu[hidden]{display:none}
  .cv-article-download-menu a{display:grid;grid-template-columns:34px minmax(0,1fr);align-items:center;gap:10px;padding:10px;border-radius:10px;color:var(--ink);text-decoration:none}
  .cv-article-download-menu a:hover,.cv-article-download-menu a:focus-visible{background:var(--panel)}
  .cv-file-icon{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--line);border-radius:9px;background:var(--paper);color:var(--coral-deep);font:700 9px/1 var(--mono)}
  .cv-article-download-menu strong,.cv-article-download-menu small{display:block}
  .cv-article-download-menu strong{font:600 13.5px/1.35 var(--sans)}
  .cv-article-download-menu small{margin-top:2px;color:var(--ink-2);font:10.5px/1.35 var(--sans)}
  .cv-article-action-status{position:absolute;right:0;top:calc(100% + 8px);width:max-content;max-width:220px;padding:5px 9px;border-radius:8px;background:var(--ink);color:var(--paper);font:11px/1.4 var(--sans);opacity:1;transition:opacity .15s}
  .cv-article-action-status:empty{opacity:0;pointer-events:none}
  @media(max-width:960px){
    .cv-article-actions-inner{padding-left:max(18px,env(safe-area-inset-left));padding-right:max(18px,env(safe-area-inset-right))}
  }
  @media(max-width:600px){
    .cv-article-actions-inner{padding-top:10px}
    .cv-article-copy,.cv-article-download-trigger{min-width:40px;min-height:40px;padding:9px}
    .cv-article-copy>span,.cv-article-download-trigger>span{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
    .cv-article-download-trigger .cv-article-download-chev{display:none}
    .cv-article-download-menu{right:0;width:min(254px,calc(100vw - 36px))}
  }
  @media print{.cv-article-actions-row{display:none!important}}
</style>
