// Cloudflare Workers 静态资产部署配置（纯静态，无 Worker 脚本）
// 用法：npm run build && npx wrangler deploy
// name 必须与线上 Worker 同名（cavno-site → https://cavno-site.tchow.workers.dev）
{
  "name": "cavno-site",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
