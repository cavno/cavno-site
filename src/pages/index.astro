---
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import nav from '../content/nav.json';
import { getCollection } from 'astro:content';

const items = (await getCollection('items')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const total = items.length;
const counts: Record<string, number> = {};
for (const s of nav.sections) counts[s.slug] = items.filter((i) => i.data.section === s.slug).length;

const ym = (d?: Date) =>
  d ? `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` : '——';
const latest = ym(items[0]?.data.date);
const recent = items.slice(0, 6);

const tagFor = (sectionSlug: string, subSlug: string) => {
  const s = nav.sections.find((x) => x.slug === sectionSlug);
  const sub = s?.subsections.find((x) => x.slug === subSlug);
  return `${s?.short ?? sectionSlug} · ${sub?.en ?? (subSlug || '未分类')}`;
};
---
<Base>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Cavno · 个人公开工作台</div>
      <h1>散落的页面，<br />收进同一张桌面。</h1>
      <p class="lede">投资、阅读与思考、生活与技能、工作工具——原先分布在四个 GitHub Pages 仓库的静态站点，现整合于同一域名、同一套视觉之下。内容经 /admin 后台维护，保存即提交、提交即构建，托管于 Cloudflare。</p>
      <div class="cta-row">
        <a class="btn btn-ink" href="#recent">浏览最近更新</a>
        <a class="btn btn-line" href="#boards">查看站点结构</a>
      </div>
    </div>

    <aside class="index-card" aria-label="站点索引">
      <div class="ic-head"><span>Site Index · 站点索引</span><b>●</b></div>
      {nav.sections.map((s) => (
        <a class="ic-row" href={`/${s.slug}/`}>
          <span>
            <span class="ic-name">{s.en}</span>
            <div class="ic-sub">{s.subsections.map((x) => x.zh).join(' · ')}</div>
          </span>
          <span class="ic-meta">{counts[s.slug]} 项 <span class="arrow">→</span></span>
        </a>
      ))}
      <div class="ic-foot">UPDATED {latest} · 共 {total} 项 · 由内容集合自动统计</div>
    </aside>
  </div>
</section>

<section class="pipeline">
  <div class="wrap">
    <div class="pl-label">Content Pipeline · 内容更新流程</div>
    <div class="pl-grid">
      <div class="pl-step"><div class="pl-num">01</div><div class="pl-t">在 /admin 编辑</div><div class="pl-d">Sveltia CMS 表单化后台，GitHub 账号登录</div></div>
      <div class="pl-step"><div class="pl-num">02</div><div class="pl-t">保存即提交</div><div class="pl-d">一次保存等于一次 commit，内容即仓库</div></div>
      <div class="pl-step"><div class="pl-num">03</div><div class="pl-t">Cloudflare 自动构建</div><div class="pl-d">Astro 静态生成，免费额度内完成</div></div>
      <div class="pl-step"><div class="pl-num">04</div><div class="pl-t">全站生效</div><div class="pl-d">约一分钟后经全球 CDN 上线</div></div>
    </div>
  </div>
</section>

<section class="section-pad" id="boards">
  <div class="wrap">
    <div class="sec-head"><h2>四个板块，一套外壳。</h2></div>
    <p class="sec-lede">每个一级板块一张目录页，二级栏目按卡片陈列；旧工具与旧页面原样迁入 /apps/ 目录，同域直达打开，不再使用 iframe 嵌套。</p>
    <div class="board-grid">
      {nav.sections.map((s) => (
        <article class="board">
          <h3>{s.en} <small>{s.zh}</small></h3>
          <p>{s.desc}</p>
          <div class="chip-row">
            {s.subsections.map((sub) => (
              <a class:list={['chip', { plan: s.planned }]} href={`/${s.slug}/${sub.slug}/`}>
                {sub.en}{sub.zh !== sub.en ? ` ${sub.zh}` : ''}
              </a>
            ))}
          </div>
          <a class="board-go" href={`/${s.slug}/`}>进入板块 →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section-pad" id="recent" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <h2>最近更新</h2>
    </div>
    <p class="sec-lede">每条对应 <code>src/content/items/</code> 下的一个 Markdown 文件，可在后台增删，也可由迁移脚本批量生成。</p>
    <div class="recent-grid">
      {recent.length > 0 ? (
        recent.map((i) => (
          <ItemCard
            href={i.data.href}
            title={i.data.title}
            summary={i.data.summary}
            tag={tagFor(i.data.section, i.data.subsection)}
            date={ym(i.data.date)}
          />
        ))
      ) : (
        <div class="empty">暂无条目。在 <code>/admin</code> 后台新增，或运行 <code>npm run migrate</code> 批量导入旧站作品。</div>
      )}
    </div>
  </div>
</section>

</Base>
