---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/orders/order-management/body.html?raw';
import '../../../legacy/life/orders/order-management/style.css';

const meta = {
  "title": "报单管理系统",
  "description": ""
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Working · Operations</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      
      <a class="cv-crumb-back" href="/working/operations/">← 返回运营栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
