            ['在手商机', formatMoney(pipelineValue), '已确认至方案评估阶段', 'pipeline'],
            ['开放任务', openTasks, '销售、触达、直播与交付共用', 'tasks'],
            ['陪练均分', state.coaching.length ? `${coachingAverage} 分` : '—', `${state.coaching.length} 次训练记录`, 'coaching'],
            ['可复用资产', state.assets.filter((item) => item.status === 'ready').length, '已审核的课程、案例与量表', 'assets'],
          ];
          $('#gos-kpis').innerHTML = kpis.map(([label, value, note, tone]) => `<article class="gos-kpi ${tone}"><span>${escapeHtml(label)}</span><strong>${escapeHtml(value)}</strong><small>${escapeHtml(note)}</small></article>`).join('');

          const loop = [
            ['radar','01','客户识别',state.customers.length,'客户主档'],
            ['sales','02','销售转化',state.customers.filter((item) => item.stage !== 'radar').length,'已接管'],
            ['nurture','03','私域经营',new Set(state.campaigns.flatMap((item) => item.customerIds)).size,'在培育'],
            ['live','04','直播运营',state.liveEvents.reduce((sum, item) => sum + item.highIntent, 0),'高意向信号'],
            ['coaching','05','AI 陪练',state.coaching.length,'交付记录'],
            ['assets','06','资产沉淀',state.assets.length,'可复用资产'],
            ['governance','07','复购反馈',state.tasks.filter((item) => item.type === 'renewal' && item.status === 'open').length,'续费任务'],
          ];
          $('#gos-growth-loop').innerHTML = loop.map(([view, no, label, value, unit], index) => `<button type="button" data-view="${view}"><small>${no}</small><strong>${escapeHtml(label)}</strong><span><b>${value}</b> ${escapeHtml(unit)}</span>${index < loop.length - 1 ? '<i aria-hidden="true">→</i>' : ''}</button>`).join('');

          const priorityTasks = state.tasks.filter((task) => task.status === 'open').sort((a, b) => a.due.localeCompare(b.due)).slice(0, 6);
          $('#gos-priority-list').innerHTML = priorityTasks.length ? priorityTasks.map((task) => {
            const customer = customerById(task.customerId);
            return `<div class="gos-priority-item"><button class="gos-task-check" type="button" data-toggle-task="${escapeHtml(task.id)}" aria-label="标记完成：${escapeHtml(task.title)}">○</button><button class="gos-priority-copy" type="button" data-open-customer="${escapeHtml(task.customerId)}"><strong>${escapeHtml(task.title)}</strong><span>${escapeHtml(customer?.name || '客户已删除')} · ${escapeHtml(task.owner)} · ${escapeHtml(formatDate(task.due))}</span></button><em>${escapeHtml(moduleMeta[task.type]?.[1] || task.type)}</em></div>`;
          }).join('') : emptyMarkup('今天没有开放任务', '从客户雷达或直播分流创建下一步动作。', '<button class="gos-text-button" type="button" data-view="radar">查看客户雷达 →</button>');

          const total = Math.max(1, state.customers.length);
          const quality = [
            ['负责人完整', state.customers.filter((item) => item.owner.trim()).length / total],
            ['下一步完整', state.customers.filter((item) => item.nextAction.trim()).length / total],
            ['处理状态确认', state.customers.filter((item) => item.consent === 'confirmed').length / total],
            ['知识资产已审核', state.assets.length ? state.assets.filter((item) => item.status === 'ready').length / state.assets.length : 0],
          ];
          $('#gos-quality').innerHTML = quality.map(([label, ratio]) => `<div class="gos-quality-row"><span>${escapeHtml(label)}</span><div class="gos-meter"><i style="width:${Math.round(ratio * 100)}%"></i></div><strong>${Math.round(ratio * 100)}%</strong></div>`).join('') + '<p class="gos-quality-note">本指标衡量数据能否支持下一步动作，不代表业务成效。</p>';

          renderTimeline($('#gos-timeline'), state.activities.slice(0, 7));
        };

        const renderTimeline = (container, activities) => {
          container.innerHTML = activities.length ? activities.map((activity) => {
            const customer = customerById(activity.customerId);
            const meta = moduleMeta[activity.module] || [activity.module, activity.module];
            return `<article class="gos-timeline-item"><span class="gos-module-dot ${escapeHtml(activity.module)}" aria-hidden="true"></span><div><button type="button" data-open-customer="${escapeHtml(activity.customerId)}">${escapeHtml(customer?.name || '客户已删除')}</button><p>${escapeHtml(activity.text)}</p><small>${escapeHtml(meta[0])} · ${escapeHtml(formatDateTime(activity.time))}${activity.assetId && assetById(activity.assetId) ? ` · 资产：${escapeHtml(assetById(activity.assetId).title)}` : ''}</small></div></article>`;
          }).join('') : emptyMarkup('还没有活动记录', '完成一次客户推进、触达或陪练后会在这里形成统一时间线。');
        };

        const renderRadar = () => {
          const query = ($('#gos-radar-search').value || '').trim().toLowerCase();
          const band = $('#gos-radar-score').value;
          const list = state.customers.filter((customer) => {
            const haystack = [customer.name, customer.industry, customer.need, customer.signal, customer.owner, ...customer.tags].join(' ').toLowerCase();
            return (!query || haystack.includes(query)) && (band === 'all' || scoreBand(customer.score) === band);
          }).sort((a, b) => b.score - a.score);
          if (!list.length) {
            $('#gos-radar-table').innerHTML = emptyMarkup('没有匹配的客户', '调整搜索条件，或录入新的需求信号。', '<button class="gos-button secondary" type="button" data-open-add>＋ 新建客户</button>');
            return;
          }
          $('#gos-radar-table').innerHTML = `<table class="gos-table"><caption>${list.length} 条客户记录；评分为可解释、可人工覆盖的排序参考</caption><thead><tr><th>企业与信号</th><th>负责人</th><th>阶段</th><th>评分与依据</th><th>下一步</th><th>操作</th></tr></thead><tbody>${list.map((customer) => `<tr><td data-label="企业与信号"><button class="gos-customer-name" type="button" data-open-customer="${escapeHtml(customer.id)}">${escapeHtml(customer.name)}</button><span>${escapeHtml(customer.industry)} · ${customer.size} 人 · ${escapeHtml(customer.source)}</span><small>${escapeHtml(customer.signal)}</small></td><td data-label="负责人"><strong>${escapeHtml(customer.owner)}</strong><span>${escapeHtml(customer.contact)}</span></td><td data-label="阶段"><span class="gos-stage ${escapeHtml(customer.stage)}">${escapeHtml(stageMeta[customer.stage][0])}</span><small>${customer.consent === 'confirmed' ? '处理状态已确认' : '待合规核验'}</small></td><td data-label="评分与依据"><span class="gos-score ${scoreBand(customer.score)}"><b>${customer.score}</b>/100</span><small>${escapeHtml(scoreReason(customer))}</small></td><td data-label="下一步"><span>${escapeHtml(customer.nextAction)}</span><small>最近触达 ${escapeHtml(formatDate(customer.lastTouch))}</small></td><td data-label="操作"><div class="gos-row-actions"><button type="button" class="gos-button tiny ghost" data-open-customer="${escapeHtml(customer.id)}">360°</button>${customer.stage === 'radar' ? `<button type="button" class="gos-button tiny primary" data-advance="${escapeHtml(customer.id)}">人工确认</button>` : ''}</div></td></tr>`).join('')}</tbody></table>`;
        };

        const renderSales = () => {
          const active = state.customers.filter((item) => ['qualified','discovery','proposal'].includes(item.stage));
          const won = state.customers.filter((item) => item.stage === 'won');
          $('#gos-pipeline-summary').innerHTML = `<span><small>在手商机</small><strong>${active.length}</strong></span><span><small>在手金额</small><strong>${formatMoney(active.reduce((sum, item) => sum + item.value, 0))}</strong></span><span><small>已成交客户</small><strong>${won.length}</strong></span><span><small>需人工确认</small><strong>${active.filter((item) => item.consent !== 'confirmed').length}</strong></span>`;
          const columns = ['qualified','discovery','proposal','won'];
          $('#gos-sales-pipeline').innerHTML = columns.map((stage) => {
            const customers = state.customers.filter((item) => item.stage === stage).sort((a, b) => b.score - a.score);
            return `<section class="gos-pipeline-column" aria-label="${escapeHtml(stageMeta[stage][0])}"><header><span>${escapeHtml(stageMeta[stage][0])}</span><strong>${customers.length}</strong></header><div>${customers.length ? customers.map((customer) => `<article class="gos-deal-card"><button class="gos-deal-title" type="button" data-open-customer="${escapeHtml(customer.id)}">${escapeHtml(customer.name)}</button><span>${escapeHtml(customer.need)}</span><div class="gos-deal-meta"><b>${formatMoney(customer.value)}</b><em>意向 ${customer.score}</em></div><p><small>下一步</small>${escapeHtml(customer.nextAction)}</p><footer><span>${escapeHtml(customer.owner)}</span><div><button type="button" class="gos-text-button" data-nurture="${escapeHtml(customer.id)}">加入培育</button>${stage !== 'won' ? `<button type="button" class="gos-button tiny primary" data-advance="${escapeHtml(customer.id)}">推进阶段</button>` : `<button type="button" class="gos-button tiny secondary" data-view="coaching">查看交付</button>`}</div></footer></article>`).join('') : emptyMarkup('暂无客户', '从前一阶段推进后会自动出现在这里。')}</div></section>`;
          }).join('');
        };

        const renderCustomerOptions = () => {
          const customers = state.customers.slice().sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'));
          const assets = state.assets.filter((item) => item.status === 'ready').sort((a, b) => a.title.localeCompare(b.title, 'zh-CN'));
          const customerOptions = customers.map((item) => `<option value="${escapeHtml(item.id)}">${escapeHtml(item.name)} · ${escapeHtml(stageMeta[item.stage][0])}</option>`).join('');
          const assetOptions = assets.map((item) => `<option value="${escapeHtml(item.id)}">${escapeHtml(assetTypeMeta[item.type])} · ${escapeHtml(item.title)}</option>`).join('');
          $('#gos-touch-customer').innerHTML = customerOptions || '<option value="">暂无客户</option>';
          $('#gos-coaching-customer').innerHTML = customerOptions || '<option value="">暂无客户</option>';
          $('#gos-touch-asset').innerHTML = assetOptions || '<option value="">暂无已审核资产</option>';
          $('#gos-touch-form').querySelector('button[type="submit"]').disabled = !customers.length || !assets.length;
          $('#gos-coaching-form').querySelector('button[type="submit"]').disabled = !customers.length || !state.assets.some((item) => item.type === 'rubric' && item.status === 'ready');
        };

        const renderCampaigns = () => {
          $('#gos-campaigns').innerHTML = state.campaigns.length ? state.campaigns.map((campaign) => {
            const asset = assetById(campaign.assetId);
            const members = campaign.customerIds.map(customerById).filter(Boolean);
            return `<article class="gos-campaign-card"><header><span class="gos-status ${escapeHtml(campaign.status)}">${campaign.status === 'running' ? '运行中' : campaign.status === 'draft' ? '草稿' : '已暂停'}</span><small>下次运行 ${escapeHtml(formatDate(campaign.nextRun))}</small></header><h4>${escapeHtml(campaign.name)}</h4><p>${escapeHtml(campaign.segment)}</p><div class="gos-campaign-asset"><span>复用资产</span><strong>${escapeHtml(asset?.title || '资产已删除')}</strong></div><div class="gos-campaign-metrics"><span><b>${campaign.customerIds.length}</b>成员</span><span><b>${campaign.sent}</b>触达</span><span><b>${campaign.engaged}</b>互动</span><span><b>${campaign.qualified}</b>转商机</span></div><div class="gos-chip-row">${members.map((item) => `<button type="button" data-open-customer="${escapeHtml(item.id)}">${escapeHtml(item.name)}</button>`).join('') || '<span>暂无成员</span>'}</div></article>`;
          }).join('') : emptyMarkup('还没有培育计划', '创建一次合规触达任务时，系统会建立默认培育计划。');
        };

        const renderLive = () => {
          $('#gos-live-events').innerHTML = state.liveEvents.length ? state.liveEvents.map((event) => {
            const asset = assetById(event.assetId);
            const customers = event.customerIds.map(customerById).filter(Boolean);
            const rate = event.attended ? Math.round(event.highIntent / event.attended * 100) : 0;
            const action = event.status === 'planned'
              ? `<button class="gos-button secondary" type="button" data-complete-live="${escapeHtml(event.id)}">模拟直播结束</button>`
              : event.followupDone
                ? '<button class="gos-button ghost" type="button" disabled>已完成会后分流</button>'
                : `<button class="gos-button primary" type="button" data-live-followup="${escapeHtml(event.id)}">人工确认会后分流</button>`;
            return `<article class="gos-live-card"><header><span class="gos-status ${escapeHtml(event.status)}">${event.status === 'planned' ? '直播前' : event.followupDone ? '已闭环' : '待会后分流'}</span><time datetime="${escapeHtml(event.date)}">${escapeHtml(formatDate(event.date))}</time></header><h3>${escapeHtml(event.title)}</h3><p>脚本资产：${escapeHtml(asset?.title || '资产已删除')}</p><div class="gos-live-metrics"><span><b>${event.registrations}</b>报名</span><span><b>${event.attended}</b>观看</span><span><b>${event.highIntent}</b>高意向</span><span><b>${rate}%</b>高意向率</span></div><div class="gos-live-flow"><span>报名</span><i>→</i><span>观看</span><i>→</i><span>提问/点击</span><i>→</i><span>人工确认</span><i>→</i><span>销售任务</span></div><div class="gos-linked-customers"><small>已识别客户</small>${customers.map((item) => `<button type="button" data-open-customer="${escapeHtml(item.id)}">${escapeHtml(item.name)}</button>`).join('') || '<span>暂无可识别客户</span>'}</div><footer>${action}<small>不会向任何外部系统发送数据</small></footer></article>`;
          }).join('') : emptyMarkup('还没有直播场次', '生产环境可从直播平台 webhook 同步场次和参与事件。');
        };

        const renderCoaching = () => {
          const list = state.coaching.slice().sort((a, b) => b.date.localeCompare(a.date));
          $('#gos-coaching-results').innerHTML = list.length ? list.slice(0, 8).map((session) => {
            const customer = customerById(session.customerId);
            const asset = assetById(session.assetId);
            return `<article class="gos-coaching-result"><header><div><button type="button" data-open-customer="${escapeHtml(session.customerId)}">${escapeHtml(customer?.name || '客户已删除')}</button><span>${escapeHtml(session.learner)} · ${escapeHtml(session.scenario)}</span></div><strong>${session.score}</strong></header><div class="gos-dimension"><span>需求挖掘</span><i><b style="width:${session.dimensions.discovery}%"></b></i><em>${session.dimensions.discovery}</em></div><div class="gos-dimension"><span>价值塑造</span><i><b style="width:${session.dimensions.value}%"></b></i><em>${session.dimensions.value}</em></div><div class="gos-dimension"><span>成交推进</span><i><b style="width:${session.dimensions.advance}%"></b></i><em>${session.dimensions.advance}</em></div><p>${escapeHtml(session.note)}</p><small>量表：${escapeHtml(asset?.title || '资产已删除')} · ${escapeHtml(formatDate(session.date))} · 待人工复核</small></article>`;
          }).join('') : emptyMarkup('还没有陪练记录', '提交左侧演练后，评分与反馈会进入客户交付时间线。');
        };

        const renderAssets = () => {
          const filter = $('#gos-asset-filter').value;
          const list = state.assets.filter((item) => filter === 'all' || item.type === filter).sort((a, b) => b.uses - a.uses);
          $('#gos-assets-list').innerHTML = list.length ? list.map((asset) => `<article class="gos-asset-card"><span class="gos-asset-type ${escapeHtml(asset.type)}">${escapeHtml(assetTypeMeta[asset.type])}</span><div><h4>${escapeHtml(asset.title)}</h4><p>${escapeHtml(asset.summary)}</p><div class="gos-chip-row">${asset.tags.map((tag) => `<span>${escapeHtml(tag)}</span>`).join('')}</div><small>负责人：${escapeHtml(asset.owner)} · ${asset.status === 'ready' ? '已审核' : '待审核'} · 已复用 ${asset.uses} 次</small></div><button class="gos-button tiny ghost" type="button" data-use-asset="${escapeHtml(asset.id)}">记录一次复用</button></article>`).join('') : emptyMarkup('没有匹配的资产', '调整类型筛选，或在右侧沉淀新资产。');
        };

        const renderGovernance = () => {
          const integrations = [
            ['共享客户与事件数据','已启用','本机演示状态','connected'],
            ['CRM / SCRM','未连接','生产需官方 API、幂等与字段映射','pending'],
            ['企业微信','未连接','生产需授权、退订与人工审批','pending'],
            ['直播平台','演示数据','生产需 webhook、身份合并与重试','demo'],
            ['真实 LLM / RAG','规则演示','生产需模型评测、引用与安全防护','demo'],
            ['持久数据库与权限','未连接','生产需服务端、RBAC、租户隔离与审计','pending'],
          ];
          $('#gos-integrations').innerHTML = integrations.map(([name, status, note, tone]) => `<article class="gos-integration ${tone}"><span aria-hidden="true"></span><div><strong>${escapeHtml(name)}</strong><p>${escapeHtml(note)}</p></div><em>${escapeHtml(status)}</em></article>`).join('');
          renderTimeline($('#gos-audit-log'), state.activities.slice(0, 30));
        };

        const suggestedAction = (customer) => {
          if (customer.consent !== 'confirmed') return { title:'先完成数据与触达合规核验', reason:'当前处理状态尚未确认，不应进入自动培育或外部联系。', type:'sales' };
          if (customer.stage === 'radar') return { title:'人工核验需求信号并确认采购角色', reason:`评分 ${customer.score}；依据为“${customer.signal}”。`, type:'sales' };
          if (customer.stage === 'qualified') return { title:'安排 30 分钟需求诊断', reason:`已确认客户匹配，当前需求为“${customer.need}”。`, type:'sales' };
          if (customer.stage === 'discovery') return { title:'用已审核案例形成一页式方案', reason:'诊断阶段需要把业务问题、对象、指标和决策链转成方案证据。', type:'sales' };
          if (customer.stage === 'proposal') return { title:'确认采购决策链、试点范围与成功指标', reason:`在手金额 ${formatMoney(customer.value)}；进入成交前应明确试点边界。`, type:'sales' };
          return { title:'复盘陪练活跃与能力变化，创建续费任务', reason:`已有 ${state.coaching.filter((item) => item.customerId === customer.id).length} 条交付记录；建议由客户成功负责人复核。`, type:'renewal' };
        };

        const renderCustomerDialog = (customerId) => {
          const customer = customerById(customerId);
          if (!customer) return;
          const activities = state.activities.filter((item) => item.customerId === customerId).sort((a, b) => b.time.localeCompare(a.time));
          const tasks = state.tasks.filter((item) => item.customerId === customerId);
          const campaigns = state.campaigns.filter((item) => item.customerIds.includes(customerId));
          const liveEvents = state.liveEvents.filter((item) => item.customerIds.includes(customerId));
          const coaching = state.coaching.filter((item) => item.customerId === customerId);
          const suggestion = suggestedAction(customer);
          const stageOptions = stageOrder.map((stage) => `<option value="${stage}" ${stage === customer.stage ? 'selected' : ''}>${escapeHtml(stageMeta[stage][0])}</option>`).join('');
          $('#gos-customer-dialog-content').innerHTML = `<div class="gos-dialog-head sticky"><div><span class="gos-eyebrow">CUSTOMER 360° · ${escapeHtml(customer.id)}</span><h2 id="gos-customer-dialog-title">${escapeHtml(customer.name)}</h2><p>${escapeHtml(customer.industry)} · ${customer.size} 人 · 负责人 ${escapeHtml(customer.owner)}</p></div><button type="button" class="gos-dialog-close" data-close-dialog aria-label="关闭">×</button></div><div class="gos-customer-overview"><span><small>当前阶段</small><strong>${escapeHtml(stageMeta[customer.stage][0])}</strong></span><span><small>意向评分</small><strong>${customer.score}/100</strong></span><span><small>商机金额</small><strong>${formatMoney(customer.value)}</strong></span><span><small>关联记录</small><strong>${activities.length + tasks.length + coaching.length}</strong></span></div><div class="gos-customer-grid"><section><div class="gos-dialog-section-head"><span class="gos-eyebrow">PROFILE</span><h3>客户主档</h3></div><form class="gos-form gos-customer-edit" data-edit-customer="${escapeHtml(customer.id)}"><div class="gos-form-grid"><label>企业名称<input name="name" maxlength="100" required value="${escapeHtml(customer.name)}" /></label><label>负责人<input name="owner" maxlength="60" required value="${escapeHtml(customer.owner)}" /></label><label>阶段<select name="stage">${stageOptions}</select></label><label>人工评分<input name="score" type="number" min="0" max="100" required value="${customer.score}" /></label><label>商机金额<input name="value" type="number" min="0" max="1000000000" value="${customer.value}" /></label><label>处理状态<select name="consent"><option value="confirmed" ${customer.consent === 'confirmed' ? 'selected' : ''}>已确认可处理</option><option value="needs-review" ${customer.consent === 'needs-review' ? 'selected' : ''}>待合规核验</option><option value="revoked" ${customer.consent === 'revoked' ? 'selected' : ''}>已撤回/退订</option></select></label><label class="wide">需求<textarea name="need" maxlength="500" required>${escapeHtml(customer.need)}</textarea></label><label class="wide">下一步<textarea name="nextAction" maxlength="500" required>${escapeHtml(customer.nextAction)}</textarea></label><label class="wide">标签<input name="tags" maxlength="400" value="${escapeHtml(customer.tags.join(', '))}" /></label></div><button class="gos-button primary" type="submit">保存主档</button></form><div class="gos-suggestion"><span class="gos-rule-badge">规则建议 v1.0 · 待人工确认</span><h3>${escapeHtml(suggestion.title)}</h3><p>${escapeHtml(suggestion.reason)} 来源：客户信号、阶段与当前业务记录。</p><button class="gos-button secondary" type="button" data-apply-suggestion="${escapeHtml(customer.id)}">确认并创建任务</button></div></section><aside><div class="gos-dialog-section-head"><span class="gos-eyebrow">LINKED RECORDS</span><h3>跨模块关联</h3></div><div class="gos-linked-summary"><span><b>${campaigns.length}</b>培育计划</span><span><b>${liveEvents.length}</b>直播</span><span><b>${coaching.length}</b>陪练</span><span><b>${tasks.filter((item) => item.status === 'open').length}</b>开放任务</span></div><div class="gos-dialog-section-head small"><span class="gos-eyebrow">TIMELINE</span><h3>统一时间线</h3></div><div class="gos-timeline compact" id="gos-dialog-timeline"></div></aside></div><div class="gos-dialog-danger"><button class="gos-text-button danger" type="button" data-delete-customer="${escapeHtml(customer.id)}">删除此演示客户及其关联记录</button><button class="gos-button ghost" type="button" data-close-dialog>关闭</button></div>`;
          renderTimeline($('#gos-dialog-timeline'), activities);
        };

        const renderAll = () => {
          renderCounts();
          renderOverview();
          renderRadar();
          renderSales();
          renderCustomerOptions();
          renderCampaigns();
          renderLive();
          renderCoaching();
          renderAssets();
          renderGovernance();
        };

        let currentView = 'overview';
        const closeMobileNav = (restoreFocus = false) => {
          root.classList.remove('nav-open');
          const button = $('#gos-menu-button');
          button.setAttribute('aria-expanded', 'false');
          button.setAttribute('aria-label', '打开模块导航');
          if (restoreFocus) button.focus();
        };
        const switchView = (view, focusWorkspace = false) => {
          if (!views.includes(view)) return;
          currentView = view;
          $$('[data-panel]').forEach((panel) => { panel.hidden = panel.dataset.panel !== view; });
          $$('.gos-nav [data-view]').forEach((button) => {
            if (button.dataset.view === view) button.setAttribute('aria-current', 'page');
            else button.removeAttribute('aria-current');
          });
          root.dataset.view = view;
          closeMobileNav();
          if (focusWorkspace) $('#gos-workspace').focus({ preventScroll:true });
        };

        const addDialog = $('#gos-add-dialog');
        const customerDialog = $('#gos-customer-dialog');
        const openAddDialog = () => {
          $('#gos-add-form').reset();
          addDialog.showModal();
          addDialog.querySelector('input[name="name"]').focus();
        };
        const openCustomerDialog = (customerId) => {
          if (!customerById(customerId)) return;
          renderCustomerDialog(customerId);
          customerDialog.dataset.customerId = customerId;
          customerDialog.showModal();
          customerDialog.querySelector('.gos-dialog-close')?.focus();
        };
        const closeDialog = (dialog) => {
          if (dialog?.open) dialog.close();
        };
        const commit = (message) => {
          saveState();
          renderAll();
          if (customerDialog.open && customerDialog.dataset.customerId && customerById(customerDialog.dataset.customerId)) renderCustomerDialog(customerDialog.dataset.customerId);
          showToast(message);
        };

        root.addEventListener('click', (event) => {
          const target = event.target.closest('button, [data-open-customer]');
          if (!target || !root.contains(target)) return;

          if (target.dataset.view) {
            switchView(target.dataset.view, true);
            return;
          }
          if (target.matches('[data-open-add]') || target.id === 'gos-new-customer') {
            openAddDialog();
            return;
          }
          if (target.dataset.openCustomer) {
            $('#gos-search-results').hidden = true;
            openCustomerDialog(target.dataset.openCustomer);
            return;
          }
          if (target.matches('[data-close-dialog]')) {
            closeDialog(target.closest('dialog'));
            return;
          }
          if (target.id === 'gos-menu-button') {
            const open = root.classList.toggle('nav-open');
            target.setAttribute('aria-expanded', String(open));
            target.setAttribute('aria-label', open ? '关闭模块导航' : '打开模块导航');
            if (open) $('#gos-sidebar').focus({ preventScroll:true });
            return;
          }
          if (target.dataset.toggleTask) {
            const task = state.tasks.find((item) => item.id === target.dataset.toggleTask);
            if (!task) return;
            task.status = task.status === 'open' ? 'done' : 'open';
            addActivity(task.customerId, moduleMeta[task.type] ? task.type : 'system', `${task.status === 'done' ? '完成' : '重新打开'}任务：${task.title}`);
            commit(task.status === 'done' ? '任务已完成并写入客户时间线' : '任务已重新打开');
            return;
          }
          if (target.dataset.advance) {
            const customer = customerById(target.dataset.advance);
            if (!customer) return;
            if (customer.consent !== 'confirmed') {
              openCustomerDialog(customer.id);
              showToast('请先在客户 360° 中完成数据处理与触达状态核验', 'warning');
              return;
            }
            const index = stageOrder.indexOf(customer.stage);
            if (index < 0 || index === stageOrder.length - 1) return;
            const previous = customer.stage;
            customer.stage = stageOrder[index + 1];
            customer.lastTouch = today();
            const next = suggestedAction(customer);
            customer.nextAction = next.title;
            addActivity(customer.id, 'sales', `人工确认阶段从“${stageMeta[previous][0]}”推进至“${stageMeta[customer.stage][0]}”`);
            if (customer.stage === 'won') {
              addTask(customer.id, 'coaching', '创建首期 AI 陪练计划并确认评分量表', customer.owner);
              addActivity(customer.id, 'coaching', '成交后创建交付与 AI 陪练启动任务');
            }
            commit(`已推进至“${stageMeta[customer.stage][0]}”`);
            return;
          }
          if (target.dataset.nurture) {
            const customer = customerById(target.dataset.nurture);
            if (!customer) return;
            if (customer.consent !== 'confirmed') {
              openCustomerDialog(customer.id);
              showToast('客户尚未确认可触达，未创建培育任务', 'warning');
              return;
            }
            const asset = state.assets.find((item) => item.status === 'ready' && item.type === 'case') || state.assets.find((item) => item.status === 'ready');
            if (!asset) {
              switchView('assets', true);
              showToast('请先准备一条已审核内容资产', 'warning');
              return;
            }
            let campaign = state.campaigns.find((item) => item.status === 'running' && item.assetId === asset.id);
            if (!campaign) {
              campaign = { id:makeId('cmp'), name:'人工确认培育计划', segment:'已确认可触达客户', status:'running', assetId:asset.id, customerIds:[], sent:0, engaged:0, qualified:0, nextRun:today() };
              state.campaigns.unshift(campaign);
            }
            if (!campaign.customerIds.includes(customer.id)) campaign.customerIds.push(customer.id);
            asset.uses += 1;
            addTask(customer.id, 'nurture', `人工发送：${asset.title}`, customer.owner);
            addActivity(customer.id, 'nurture', `加入“${campaign.name}”，复用资产“${asset.title}”；仅创建待办，未自动发送`, asset.id);
            commit('已加入培育计划，并创建人工触达待办');
            return;
          }
          if (target.dataset.completeLive) {
            const live = state.liveEvents.find((item) => item.id === target.dataset.completeLive);
            if (!live || live.status !== 'planned') return;
            live.status = 'followup';
            live.attended = Math.max(live.attended, Math.round(live.registrations * .58));
            live.highIntent = Math.max(live.highIntent, Math.max(1, Math.round(live.attended * .14)));
            for (const customerId of live.customerIds) addActivity(customerId, 'live', `完成直播“${live.title}”，形成待人工确认的观看与互动信号`, live.assetId);
            commit('直播结束数据已进入待分流队列');
            return;
          }
          if (target.dataset.liveFollowup) {
            const live = state.liveEvents.find((item) => item.id === target.dataset.liveFollowup);
            if (!live || live.followupDone) return;
            if (!window.confirm('确认将已识别客户写入销售待办？此演示不会向任何外部系统发送消息。')) return;
            live.followupDone = true;
            live.status = 'completed';
            live.converted = Math.max(live.converted, live.customerIds.length);
            for (const customerId of live.customerIds) {
              const customer = customerById(customerId);
              if (!customer) continue;
              customer.lastTouch = today();
              if (customer.consent === 'confirmed' && customer.stage === 'radar') customer.stage = 'qualified';
              customer.score = Math.min(100, customer.score + 6);
              const title = customer.consent === 'confirmed' ? `跟进直播高意向问题：${live.title}` : '先核验数据处理状态，再决定是否跟进直播信号';
              addTask(customer.id, 'live', title, customer.owner);
              addActivity(customer.id, 'live', `人工确认直播会后分流；评分更新为 ${customer.score}，未执行自动触达`, live.assetId);
            }
            const asset = assetById(live.assetId);
            if (asset) asset.uses += 1;
            commit('会后分流完成：客户、任务和资产使用记录已联动更新');
            return;
          }
          if (target.dataset.useAsset) {
            const asset = assetById(target.dataset.useAsset);
            if (!asset) return;
            asset.uses += 1;
            commit(`已记录“${asset.title}”的一次复用`);
            return;
          }
          if (target.dataset.applySuggestion) {
            const customer = customerById(target.dataset.applySuggestion);
            if (!customer) return;
            const suggestion = suggestedAction(customer);
            addTask(customer.id, suggestion.type, suggestion.title, customer.owner);
            customer.nextAction = suggestion.title;
            addActivity(customer.id, suggestion.type === 'renewal' ? 'coaching' : 'sales', `人工采纳规则建议：${suggestion.title}`);
            commit('建议已由人工确认并写入任务');
            return;
          }
          if (target.dataset.deleteCustomer) {
            const customer = customerById(target.dataset.deleteCustomer);
            if (!customer || !window.confirm(`删除“${customer.name}”及其任务、活动和陪练记录？此操作仅影响当前浏览器演示数据。`)) return;
            state.customers = state.customers.filter((item) => item.id !== customer.id);
            state.tasks = state.tasks.filter((item) => item.customerId !== customer.id);
            state.activities = state.activities.filter((item) => item.customerId !== customer.id);
            state.coaching = state.coaching.filter((item) => item.customerId !== customer.id);
            state.campaigns.forEach((item) => { item.customerIds = item.customerIds.filter((id) => id !== customer.id); });
            state.liveEvents.forEach((item) => { item.customerIds = item.customerIds.filter((id) => id !== customer.id); });
            closeDialog(customerDialog);
            customerDialog.dataset.customerId = '';
            commit('客户及其关联演示记录已删除');
            return;
          }
          if (target.id === 'gos-export-button') {
            const payload = { schemaVersion:SCHEMA_VERSION, exportedAt:nowIso(), data:clone(state) };
            const blob = new Blob([JSON.stringify(payload, null, 2)], { type:'application/json' });
            const url = URL.createObjectURL(blob);
            const link = root.ownerDocument.createElement('a');
            link.href = url;
            link.download = `cavno-ai-growth-os-${today()}.json`;
            link.click();
            setTimeout(() => URL.revokeObjectURL(url), 0);
            showToast('完整业务数据已导出为 JSON');
            return;
          }
          if (target.id === 'gos-import-button') {
            $('#gos-import-input').click();
            return;
          }
          if (target.id === 'gos-reset-button') {
            if (!window.confirm('恢复固定演示数据并覆盖当前本机内容？')) return;
            state = clone(DEMO_STATE);
            closeDialog(customerDialog);
            commit('已恢复固定演示数据');
            return;
          }
          if (target.id === 'gos-clear-button') {
            if (!window.confirm('清空当前浏览器中的全部业务实体？导出后再清空可以保留备份。')) return;
            state = blankState();
            closeDialog(customerDialog);
            commit('本机业务实体已清空');
          }
        });

        root.addEventListener('submit', (event) => {
          event.preventDefault();
          const form = event.target;
          const values = new FormData(form);

          if (form.id === 'gos-add-form') {
            const customer = {
              id:makeId('cus'),
              name:String(values.get('name') || '').trim(),
              industry:String(values.get('industry') || '').trim(),
              size:Number(values.get('size')),
              contact:String(values.get('contact') || '').trim() || '待确认',
              owner:String(values.get('owner') || '').trim(),
              stage:'radar',
              score:Number(values.get('score')),
              source:String(values.get('source') || '手工录入'),
              signal:String(values.get('signal') || '').trim(),
              need:String(values.get('need') || '').trim(),
              tags:[String(values.get('industry') || '').trim(), '新线索'].filter(Boolean),
              consent:String(values.get('consent') || 'needs-review'),
              lastTouch:today(),
              nextAction:'人工核验信号来源、采购角色与需求时机',
              value:0,
            };
            try {
              const test = clone(state);
              test.customers.push(customer);
              test.updatedAt = nowIso();
              validateData(test);
            } catch (error) {
              showToast(error.message || '客户数据无效', 'error');
              return;
            }
            state.customers.unshift(customer);
            addActivity(customer.id, 'radar', `录入需求信号：${customer.signal}`);
            closeDialog(addDialog);
            commit('客户已进入雷达，并建立统一 customer_id');
            switchView('radar');
            return;
          }

          if (form.matches('[data-edit-customer]')) {
            const customer = customerById(form.dataset.editCustomer);
            if (!customer) return;
            const previousStage = customer.stage;
            customer.name = String(values.get('name') || '').trim();
            customer.owner = String(values.get('owner') || '').trim();
            customer.stage = String(values.get('stage'));
            customer.score = Number(values.get('score'));
            customer.value = Number(values.get('value')) || 0;
            customer.consent = String(values.get('consent'));
            customer.need = String(values.get('need') || '').trim();
            customer.nextAction = String(values.get('nextAction') || '').trim();
            customer.tags = String(values.get('tags') || '').split(/[,，]/).map((item) => item.trim()).filter(Boolean).slice(0, 20);
            customer.lastTouch = today();
            if (customer.consent !== 'confirmed') state.campaigns.forEach((item) => { item.customerIds = item.customerIds.filter((id) => id !== customer.id); });
            addActivity(customer.id, 'system', `人工更新客户主档${previousStage !== customer.stage ? `，阶段改为“${stageMeta[customer.stage][0]}”` : ''}`);
            commit('客户主档已更新，所有模块同步生效');
            return;
          }

          if (form.id === 'gos-touch-form') {
            const customer = customerById(String(values.get('customerId')));
            const asset = assetById(String(values.get('assetId')));
            const purpose = String(values.get('purpose') || '').trim();
            if (!customer || !asset) { showToast('请选择有效客户和内容资产', 'error'); return; }
            if (customer.consent !== 'confirmed') { showToast('该客户尚未确认可触达，未创建任务', 'warning'); openCustomerDialog(customer.id); return; }
            let campaign = state.campaigns.find((item) => item.status === 'running' && item.assetId === asset.id);
            if (!campaign) {
              campaign = { id:makeId('cmp'), name:`${asset.title}培育计划`, segment:'人工选择 · 已确认可触达', status:'running', assetId:asset.id, customerIds:[], sent:0, engaged:0, qualified:0, nextRun:today() };
              state.campaigns.unshift(campaign);
            }
            if (!campaign.customerIds.includes(customer.id)) campaign.customerIds.push(customer.id);
            asset.uses += 1;
            addTask(customer.id, 'nurture', purpose, customer.owner);
            addActivity(customer.id, 'nurture', `创建人工触达待办并引用“${asset.title}”：${purpose}`, asset.id);
            form.reset();
            commit('触达待办已创建；系统未发送任何外部消息');
            return;
          }

          if (form.id === 'gos-coaching-form') {
            const customer = customerById(String(values.get('customerId')));
            const rubric = state.assets.find((item) => item.type === 'rubric' && item.status === 'ready');
            const answer = String(values.get('answer') || '').trim();
            if (!customer || !rubric) { showToast('缺少客户或已审核评分量表', 'error'); return; }
            const keywordScore = (keywords) => Math.min(28, keywords.filter((word) => answer.includes(word)).length * 7);
            const lengthScore = Math.min(22, Math.round(answer.length / 12));
            const discovery = Math.min(95, 45 + lengthScore + keywordScore(['追问','原因','标准','目标','为什么']));
            const value = Math.min(95, 43 + lengthScore + keywordScore(['价值','影响','成本','结果','周期']));
            const advance = Math.min(95, 42 + lengthScore + keywordScore(['下一步','确认','安排','试点','会议']));
            const score = average([discovery, value, advance]);
            const lowest = [['需求挖掘',discovery],['价值塑造',value],['成交推进',advance]].sort((a,b) => a[1] - b[1])[0][0];
            const note = `规则评分显示“${lowest}”是当前优先改进项。建议加入可验证证据，并明确由客户确认的下一步。`;
            state.coaching.unshift({ id:makeId('coach'), customerId:customer.id, learner:String(values.get('learner') || '').trim(), scenario:String(values.get('scenario')), score, dimensions:{ discovery, value, advance }, date:today(), assetId:rubric.id, note });
            rubric.uses += 1;
            addActivity(customer.id, 'coaching', `完成“${String(values.get('scenario'))}”规则陪练，综合得分 ${score}；结果待人工复核`, rubric.id);
            const customerSessions = state.coaching.filter((item) => item.customerId === customer.id).length;
            if (customer.stage === 'won' && customerSessions >= 3) addTask(customer.id, 'renewal', '复盘陪练活跃与能力变化，评估下一周期方案', customer.owner);
            form.reset();
            form.querySelector('input[name="learner"]').value = '销售一组';
            commit('陪练结果已关联客户、量表与交付时间线');
            return;
          }

          if (form.id === 'gos-asset-form') {
            const tags = String(values.get('tags') || '').split(/[,，]/).map((item) => item.trim()).filter(Boolean).slice(0, 20);
            const asset = { id:makeId('ast'), type:String(values.get('type')), title:String(values.get('title') || '').trim(), summary:String(values.get('summary') || '').trim(), status:'review', uses:0, owner:'当前用户', tags };
            const test = clone(state);
            test.assets.push(asset);
            test.updatedAt = nowIso();
            try { validateData(test); } catch (error) { showToast(error.message || '资产数据无效', 'error'); return; }
            state.assets.unshift(asset);
            form.reset();
            commit('新资产已进入待审核状态，审核前不会被自动推荐');
          }
        });

        const validateEnvelope = (payload) => {
          inspectJsonSafety(payload);
          assert(isPlainObject(payload), '导入文件顶层必须是对象');
          assertKeys(payload, ['schemaVersion','exportedAt','data'], '导入文件');
          assert(payload.schemaVersion === SCHEMA_VERSION, `不支持的数据版本：${payload.schemaVersion}`);
          assert(isDate(payload.exportedAt), 'exportedAt 不是有效时间');
          return validateData(payload.data);
        };

        $('#gos-import-input').addEventListener('change', async (event) => {
          const input = event.currentTarget;
          const file = input.files?.[0];
          input.value = '';
          if (!file) return;
          if (file.size > MAX_IMPORT_BYTES) { showToast('导入失败：JSON 文件不得超过 2 MB', 'error'); return; }
          if (file.type && file.type !== 'application/json' && !file.name.toLowerCase().endsWith('.json')) { showToast('导入失败：请选择 JSON 文件', 'error'); return; }
          try {
            const text = await file.text();
            assert(text.trim().length > 0, '文件为空');
            const nextState = validateEnvelope(JSON.parse(text));
            const summary = `客户 ${nextState.customers.length} 条、活动 ${nextState.activities.length} 条、资产 ${nextState.assets.length} 条。`;
            if (!window.confirm(`导入将完整覆盖当前本机演示数据。\n${summary}\n是否继续？`)) return;
            state = nextState;
            closeDialog(customerDialog);
            saveState();
            renderAll();
            switchView('overview');
            showToast('JSON 已完整校验并原子替换当前数据');
          } catch (error) {
            showToast(`导入失败：${error instanceof SyntaxError ? 'JSON 格式损坏' : error.message || '数据结构无效'}`, 'error');
          }
        });

        const renderGlobalSearch = () => {
          const input = $('#gos-global-search');
          const results = $('#gos-search-results');
          const query = input.value.trim().toLowerCase();
          if (!query) { results.hidden = true; results.innerHTML = ''; return; }
          const matches = state.customers.filter((customer) => [customer.name, customer.industry, customer.need, customer.owner, ...customer.tags].join(' ').toLowerCase().includes(query)).slice(0, 6);
          results.innerHTML = matches.length ? matches.map((customer) => `<button type="button" data-open-customer="${escapeHtml(customer.id)}"><strong>${escapeHtml(customer.name)}</strong><span>${escapeHtml(customer.industry)} · ${escapeHtml(customer.owner)} · ${escapeHtml(stageMeta[customer.stage][0])}</span></button>`).join('') : '<span class="gos-search-empty">没有匹配客户</span>';
          results.hidden = false;
        };

        $('#gos-global-search').addEventListener('input', renderGlobalSearch);
        $('#gos-global-search').addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            const first = $('#gos-search-results [data-open-customer]');
            if (first) { event.preventDefault(); first.click(); }
          }
          if (event.key === 'Escape') { $('#gos-search-results').hidden = true; event.currentTarget.blur(); }
        });
        $('#gos-radar-search').addEventListener('input', renderRadar);
        $('#gos-radar-score').addEventListener('change', renderRadar);
        $('#gos-asset-filter').addEventListener('change', renderAssets);

        for (const dialog of [addDialog, customerDialog]) {
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
        }

        document.addEventListener('keydown', (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            $('#gos-global-search').focus();
          }
          if (event.key === 'Escape' && root.classList.contains('nav-open')) closeMobileNav(true);
        });

        saveState();
        renderAll();
        switchView('overview');
      })();
    </script>
  </article>

  <style>
    .cv-page-links{display:flex;flex-wrap:wrap;gap:8px 20px}
  </style>
</Base>
