---
import Base from '../../../layouts/Base.astro';
import '../../../styles/growth-os.css';

const meta = {
  title: '企业培训 AI 增长操作系统',
  description: '把客户识别、销售转化、私域经营、直播运营、AI 陪练与内容资产连接到同一条数据主线的可操作一体化工作台。',
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>
  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Working · Training · Growth OS</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <div class="cv-page-links">
        <a class="cv-crumb-back" href="/working/training/">← 返回企业培训栏目</a>
        <a class="cv-crumb-back" href="/working/training/ai-training-agency-transformation/">查看转型方法 →</a>
      </div>
    </div>
  </section>

  <article class="growth-os" id="growth-os-root">
    <a class="gos-skip" href="#gos-workspace">跳到工作区</a>

    <div class="gos-app">
      <header class="gos-topbar">
        <button class="gos-icon-button gos-menu-button" id="gos-menu-button" type="button" aria-label="打开模块导航" aria-controls="gos-sidebar" aria-expanded="false">☰</button>
        <div class="gos-brand">
          <span class="gos-brand-mark" aria-hidden="true">G</span>
          <span><strong>Growth OS</strong><small>企业培训增长工作台</small></span>
        </div>
        <label class="gos-global-search" for="gos-global-search">
          <span>搜索</span>
          <input id="gos-global-search" type="search" autocomplete="off" placeholder="客户、行业、需求或负责人" />
          <span class="gos-search-hint">⌘ K</span>
          <span class="gos-search-results" id="gos-search-results" hidden></span>
        </label>
        <div class="gos-top-actions" aria-label="数据操作">
          <span class="gos-mode-badge" id="gos-storage-badge">本机演示数据</span>
          <button class="gos-button ghost" id="gos-import-button" type="button">导入</button>
          <button class="gos-button ghost" id="gos-export-button" type="button">导出</button>
          <button class="gos-button primary" id="gos-new-customer" type="button">＋ 新建客户</button>
        </div>
      </header>

      <div class="gos-layout">
        <aside class="gos-sidebar" id="gos-sidebar" aria-label="工作台模块" tabindex="-1">
          <nav class="gos-nav">
            <p>经营闭环</p>
            <button type="button" data-view="overview" aria-current="page"><span aria-hidden="true">◫</span><strong>经营驾驶舱</strong><em id="gos-count-overview">实时</em></button>
            <button type="button" data-view="radar"><span aria-hidden="true">◎</span><strong>客户雷达</strong><em id="gos-count-radar">0</em></button>
            <button type="button" data-view="sales"><span aria-hidden="true">↗</span><strong>销售管道</strong><em id="gos-count-sales">0</em></button>
            <button type="button" data-view="nurture"><span aria-hidden="true">◇</span><strong>私域经营</strong><em id="gos-count-nurture">0</em></button>
            <button type="button" data-view="live"><span aria-hidden="true">◉</span><strong>直播运营</strong><em id="gos-count-live">0</em></button>
            <button type="button" data-view="coaching"><span aria-hidden="true">△</span><strong>AI 陪练</strong><em id="gos-count-coaching">0</em></button>
            <p>系统资产</p>
            <button type="button" data-view="assets"><span aria-hidden="true">▤</span><strong>资产中心</strong><em id="gos-count-assets">0</em></button>
            <button type="button" data-view="governance"><span aria-hidden="true">⌁</span><strong>集成与治理</strong><em>边界</em></button>
          </nav>
          <div class="gos-sidebar-note">
            <strong>统一数据主线</strong>
            <span>customer_id 贯通信号、商机、触达、直播、交付与复购。</span>
          </div>
        </aside>

        <div class="gos-workspace" id="gos-workspace" role="region" aria-label="AI 增长操作系统工作区" tabindex="-1">
          <noscript>
            <div class="gos-noscript"><strong>此工作台需要 JavaScript 才能操作。</strong><span>你仍可返回转型方法页阅读完整业务框架。</span></div>
          </noscript>

          <section class="gos-panel" id="gos-panel-overview" data-panel="overview" aria-labelledby="gos-overview-title">
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">COMMAND CENTER</span><h2 id="gos-overview-title">经营驾驶舱</h2><p>指标全部从共享业务数据实时计算；任何模块的动作都会回写到客户 360° 记录。</p></div>
              <div class="gos-panel-actions"><button class="gos-button secondary" type="button" data-view="radar">查看高意向客户</button><button class="gos-button primary" type="button" data-open-add>录入新线索</button></div>
            </div>

            <div class="gos-boundary-banner" role="note">
              <span class="gos-boundary-icon" aria-hidden="true">i</span>
              <div><strong>当前为可操作的浏览器本地 MVP</strong><p>数据只保存在这台设备，不连接真实 CRM、企业微信、直播平台或大模型；可用 JSON 导入/导出完整业务数据。生产化接入点集中在“集成与治理”。</p></div>
            </div>

            <div class="gos-kpis" id="gos-kpis" aria-label="实时经营指标"></div>

            <div class="gos-data-spine" aria-label="一体化数据链路">
              <div class="gos-section-label"><span>一条数据主线</span><strong>从信号到复购，每一步都留下可复用记录</strong></div>
              <div class="gos-loop" id="gos-growth-loop"></div>
            </div>

            <div class="gos-dashboard-grid">
              <section class="gos-surface gos-priority-panel" aria-labelledby="gos-priority-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">NEXT BEST ACTION</span><h3 id="gos-priority-title">今日优先动作</h3></div><button class="gos-text-button" type="button" data-view="sales">进入销售管道 →</button></div>
                <div id="gos-priority-list"></div>
              </section>
              <section class="gos-surface" aria-labelledby="gos-quality-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">DATA READINESS</span><h3 id="gos-quality-title">数据可用度</h3></div></div>
                <div id="gos-quality"></div>
              </section>
              <section class="gos-surface gos-wide" aria-labelledby="gos-timeline-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">SHARED ACTIVITY STREAM</span><h3 id="gos-timeline-title">跨模块活动流</h3></div><button class="gos-text-button" type="button" data-view="governance">查看完整审计 →</button></div>
                <div class="gos-timeline" id="gos-timeline"></div>
              </section>
            </div>
          </section>

          <section class="gos-panel" id="gos-panel-radar" data-panel="radar" aria-labelledby="gos-radar-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">CUSTOMER RADAR</span><h2 id="gos-radar-title">客户识别与可解释评分</h2><p>把合规信号组织成客户画像；评分只用于辅助排序，最终由人工确认。</p></div>
              <div class="gos-panel-actions"><button class="gos-button primary" type="button" data-open-add>＋ 新建客户</button></div>
            </div>
            <div class="gos-toolbar">
              <label>搜索客户<input id="gos-radar-search" type="search" placeholder="名称、行业、需求、标签" /></label>
              <label>意向区间<select id="gos-radar-score"><option value="all">全部评分</option><option value="high">高意向 ≥ 75</option><option value="medium">培育中 50–74</option><option value="low">待核验 &lt; 50</option></select></label>
              <span class="gos-toolbar-note">评分依据：需求匹配、购买时机、可触达性与信息完整度</span>
            </div>
            <div class="gos-table-wrap" id="gos-radar-table"></div>
          </section>

          <section class="gos-panel" id="gos-panel-sales" data-panel="sales" aria-labelledby="gos-sales-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">HUMAN-IN-THE-LOOP SALES</span><h2 id="gos-sales-title">销售转化管道</h2><p>规则建议下一步动作，销售负责人确认后再推进阶段；所有变化写入统一活动流。</p></div>
              <div class="gos-panel-actions"><button class="gos-button secondary" type="button" data-view="radar">从雷达选客户</button></div>
            </div>
            <div class="gos-pipeline-summary" id="gos-pipeline-summary"></div>
            <div class="gos-pipeline" id="gos-sales-pipeline" aria-label="销售阶段看板"></div>
          </section>

          <section class="gos-panel" id="gos-panel-nurture" data-panel="nurture" aria-labelledby="gos-nurture-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">PRIVATE DOMAIN OPERATIONS</span><h2 id="gos-nurture-title">私域经营与内容触达</h2><p>客户分层、内容资产与触达任务共用同一客户记录；本 MVP 只创建待人工确认任务，不实际发送消息。</p></div>
            </div>
            <div class="gos-two-col">
              <section class="gos-surface" aria-labelledby="gos-touch-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">CREATE TOUCH</span><h3 id="gos-touch-title">创建合规触达任务</h3></div></div>
                <form class="gos-form" id="gos-touch-form">
                  <label>目标客户<select id="gos-touch-customer" name="customerId" required></select></label>
                  <label>复用内容资产<select id="gos-touch-asset" name="assetId" required></select></label>
                  <label>触达目的<textarea name="purpose" maxlength="240" required placeholder="例如：发送制造业销售训练案例，并邀请参加需求诊断会"></textarea></label>
                  <label class="gos-check"><input name="confirmed" type="checkbox" required /><span>我已确认客户授权、沟通渠道和退出机制</span></label>
                  <button class="gos-button primary" type="submit">生成待办，不自动发送</button>
                </form>
              </section>
              <section class="gos-surface" aria-labelledby="gos-campaign-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">NURTURE PROGRAMS</span><h3 id="gos-campaign-title">培育计划</h3></div></div>
                <div id="gos-campaigns"></div>
              </section>
            </div>
          </section>

          <section class="gos-panel" id="gos-panel-live" data-panel="live" aria-labelledby="gos-live-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">LIVE OPERATIONS</span><h2 id="gos-live-title">直播前、中、后转化链</h2><p>主题、报名、观看和高意向信号回到同一客户池；会后分流需人工确认才写入销售任务。</p></div>
            </div>
            <div class="gos-live-grid" id="gos-live-events"></div>
          </section>

          <section class="gos-panel" id="gos-panel-coaching" data-panel="coaching" aria-labelledby="gos-coaching-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">AI COACHING PRODUCT</span><h2 id="gos-coaching-title">AI 陪练与交付数据</h2><p>用规则评分演示课程知识如何进入岗位训练；结果关联客户、学习者、场景与知识资产。</p></div>
            </div>
            <div class="gos-two-col coaching">
              <section class="gos-surface" aria-labelledby="gos-session-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">PRACTICE SESSION</span><h3 id="gos-session-title">完成一次销售陪练</h3></div><span class="gos-rule-badge">规则评分演示</span></div>
                <form class="gos-form" id="gos-coaching-form">
                  <label>所属客户<select id="gos-coaching-customer" name="customerId" required></select></label>
                  <label>学习者或团队<input name="learner" maxlength="80" required value="销售一组" /></label>
                  <label>训练场景<select name="scenario"><option>价格异议处理</option><option>需求诊断</option><option>价值呈现</option><option>成交推进</option></select></label>
                  <div class="gos-scenario"><span>客户提出：</span><strong>“你们的方案不错，但价格必须再降 20%。”</strong></div>
                  <label>你的回答<textarea name="answer" minlength="20" maxlength="1200" required placeholder="请先追问背景，再说明价值与下一步……"></textarea></label>
                  <button class="gos-button primary" type="submit">提交并生成演示评分</button>
                </form>
              </section>
              <section class="gos-surface" aria-labelledby="gos-results-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">DELIVERY DATA</span><h3 id="gos-results-title">最近训练结果</h3></div></div>
                <div id="gos-coaching-results"></div>
              </section>
            </div>
          </section>

          <section class="gos-panel" id="gos-panel-assets" data-panel="assets" aria-labelledby="gos-assets-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">REUSABLE SYSTEM ASSETS</span><h2 id="gos-assets-title">内容与交付资产中心</h2><p>课程、案例、话术、直播脚本和评分标准都以版本化资产被复用，并记录使用次数。</p></div>
            </div>
            <div class="gos-two-col assets">
              <section class="gos-surface" aria-labelledby="gos-library-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">LIBRARY</span><h3 id="gos-library-title">资产库</h3></div><label class="gos-inline-filter">类型<select id="gos-asset-filter"><option value="all">全部</option><option value="case">案例</option><option value="course">课程</option><option value="script">话术/脚本</option><option value="rubric">评分标准</option><option value="knowledge">知识</option></select></label></div>
                <div id="gos-assets-list"></div>
              </section>
              <section class="gos-surface" aria-labelledby="gos-new-asset-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">NEW ASSET</span><h3 id="gos-new-asset-title">沉淀新资产</h3></div></div>
                <form class="gos-form" id="gos-asset-form">
                  <label>资产名称<input name="title" maxlength="120" required placeholder="例如：制造业销售新人首单案例" /></label>
                  <label>类型<select name="type"><option value="case">案例</option><option value="course">课程</option><option value="script">话术/脚本</option><option value="rubric">评分标准</option><option value="knowledge">知识</option></select></label>
                  <label>标签<input name="tags" maxlength="160" placeholder="制造业, 销售新人, 首单" /></label>
                  <label>内容摘要<textarea name="summary" maxlength="600" required></textarea></label>
                  <label class="gos-check"><input name="authorized" type="checkbox" required /><span>已确认课程、案例和对话内容可被授权使用</span></label>
                  <button class="gos-button primary" type="submit">保存为可复用资产</button>
                </form>
              </section>
            </div>
          </section>

          <section class="gos-panel" id="gos-panel-governance" data-panel="governance" aria-labelledby="gos-governance-title" hidden>
            <div class="gos-panel-head">
              <div><span class="gos-eyebrow">INTEGRATION & GOVERNANCE</span><h2 id="gos-governance-title">生产接入与数据治理</h2><p>演示能力与生产能力明确分层；所有外部执行、评分和自动化都保留权限、审计与人工接管。</p></div>
              <div class="gos-panel-actions"><button class="gos-button ghost" id="gos-reset-button" type="button">恢复演示数据</button><button class="gos-button danger" id="gos-clear-button" type="button">清空本机业务数据</button></div>
            </div>
            <div class="gos-integration-grid" id="gos-integrations"></div>
            <div class="gos-two-col governance">
              <section class="gos-surface" aria-labelledby="gos-model-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">SHARED DATA MODEL</span><h3 id="gos-model-title">共享数据实体</h3></div></div>
                <div class="gos-entity-map">
                  <span class="core">客户 customer_id</span><span>信号</span><span>商机</span><span>任务</span><span>触达</span><span>直播</span><span>训练</span><span>内容资产 asset_id</span>
                </div>
                <ul class="gos-governance-list">
                  <li><strong>合规：</strong>合法来源、目的限制、最小必要、保存期限与退出机制。</li>
                  <li><strong>权限：</strong>生产环境需角色权限、租户隔离、字段级访问与审批。</li>
                  <li><strong>AI：</strong>知识授权、引用溯源、效果评测、提示注入与泄漏防护。</li>
                  <li><strong>人机协作：</strong>AI 只建议；高影响销售、触达与员工评价由人工确认。</li>
                </ul>
              </section>
              <section class="gos-surface" aria-labelledby="gos-audit-title">
                <div class="gos-surface-head"><div><span class="gos-eyebrow">AUDIT LOG</span><h3 id="gos-audit-title">本机活动审计</h3></div></div>
                <div class="gos-audit" id="gos-audit-log"></div>
              </section>
            </div>
          </section>
        </div>
      </div>
    </div>

    <dialog class="gos-dialog" id="gos-add-dialog" aria-labelledby="gos-add-title">
      <form class="gos-dialog-form" id="gos-add-form">
        <div class="gos-dialog-head"><div><span class="gos-eyebrow">NEW CUSTOMER</span><h2 id="gos-add-title">录入客户与需求信号</h2></div><button type="button" class="gos-dialog-close" data-close-dialog aria-label="关闭">×</button></div>
        <div class="gos-form-grid">
          <label>企业名称<input name="name" maxlength="100" required /></label>
          <label>行业<input name="industry" maxlength="80" required /></label>
          <label>企业规模（人）<input name="size" type="number" min="1" max="1000000" required /></label>
          <label>负责人<input name="owner" maxlength="60" required /></label>
          <label>联系人<input name="contact" maxlength="80" /></label>
          <label>信号来源<select name="source"><option value="公开信号">公开信号</option><option value="直播">直播</option><option value="转介绍">转介绍</option><option value="官网咨询">官网咨询</option><option value="活动">活动</option></select></label>
          <label class="wide">需求信号<textarea name="signal" maxlength="280" required placeholder="例如：近期招聘 50 名销售，计划在 60 天内完成新人上岗"></textarea></label>
          <label class="wide">推测需求<textarea name="need" maxlength="280" required placeholder="例如：销售新人训练与管理者带教"></textarea></label>
          <label>初始评分（0–100）<input name="score" type="number" min="0" max="100" value="60" required /></label>
          <label>数据处理状态<select name="consent"><option value="needs-review">待合规核验</option><option value="confirmed">已确认可处理</option></select></label>
        </div>
        <p class="gos-form-help">请勿录入真实敏感个人信息。评分是人工可覆盖的排序参考，不是事实判断。</p>
        <div class="gos-dialog-actions"><button class="gos-button ghost" type="button" data-close-dialog>取消</button><button class="gos-button primary" type="submit">保存到客户雷达</button></div>
      </form>
    </dialog>

    <dialog class="gos-dialog customer" id="gos-customer-dialog" aria-labelledby="gos-customer-dialog-title">
      <div id="gos-customer-dialog-content"><h2 id="gos-customer-dialog-title" class="gos-visually-hidden">客户 360°</h2></div>
    </dialog>

    <input id="gos-import-input" type="file" accept="application/json,.json" aria-label="导入 Growth OS JSON 数据文件" hidden />
    <div class="gos-toast" id="gos-toast" role="status" aria-live="polite" aria-atomic="true" hidden></div>

    <script is:inline>
      (() => {
        const root = document.currentScript?.closest('.growth-os');
        if (!root || root.dataset.initialized === 'true') return;
        root.dataset.initialized = 'true';

        const STORAGE_KEY = 'cavno:working:training:ai-growth-os:v1';
        const SCHEMA_VERSION = 1;
        const MAX_IMPORT_BYTES = 2 * 1024 * 1024;
        const views = ['overview', 'radar', 'sales', 'nurture', 'live', 'coaching', 'assets', 'governance'];
        const stageOrder = ['radar', 'qualified', 'discovery', 'proposal', 'won'];
        const stageMeta = {
          radar: ['待识别', '雷达'],
          qualified: ['已确认', '销售'],
          discovery: ['需求诊断', '销售'],
          proposal: ['方案评估', '销售'],
          won: ['已成交', '交付'],
        };
        const moduleMeta = {
          radar: ['客户雷达', '识别'], sales: ['销售管道', '转化'], nurture: ['私域经营', '触达'],
          live: ['直播运营', '直播'], coaching: ['AI 陪练', '交付'], assets: ['资产中心', '资产'], system: ['系统', '治理'],
        };
        const assetTypeMeta = { case: '案例', course: '课程', script: '话术/脚本', rubric: '评分标准', knowledge: '知识' };

        const DEMO_STATE = {
          updatedAt: '2026-08-25T03:30:00.000Z',
          customers: [
            { id:'cus-qiming', name:'启明精密制造（示例）', industry:'制造业', size:620, contact:'李总', owner:'周宁', stage:'proposal', score:88, source:'直播', signal:'新建华南销售团队并招聘 60 名销售', need:'新人首单训练与一线经理带教', tags:['制造业','销售扩张','高意向'], consent:'confirmed', lastTouch:'2026-08-25', nextAction:'确认 60 天训练方案与采购决策链', value:180000 },
