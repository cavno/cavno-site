---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/investing/options/options-atlas/body.html?raw';
import '../../../legacy/investing/options/options-atlas/style.css';

const meta = {
  "title": "Options Strategy Atlas · 期权策略图谱",
  "description": "An interactive reference for 65 options strategies — Greeks, structure, legs, and payoff diagrams."
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Investing · Options</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/investing/options/">← 返回期权栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
