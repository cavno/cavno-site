---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/house/longgang-home-school-decision/body.html?raw';
import '../../../legacy/life/house/longgang-home-school-decision/style.css';
const title = "二胎家庭置业与学位多维可视化决策平台";
const description = "11盘全量覆盖 · 布吉/南湾 + 龙岗大运";
---
<Base title={title + ' · Cavno'} description={description}>
  <main id="hd-main">
    <section class="cv-page-head hd-page-head">
      <div class="cv-wrap">
        <div class="cv-eyebrow">Life &amp; Skills · House</div>
        <h1 class="cv-page-title" id="hd-title">{title}</h1>
        <a class="cv-crumb-back" href="/life/house/">← 返回房产栏目</a>
        <nav class="hd-jump" aria-label="工具导航">
          <a href="#hd-weights">权重与严选推荐</a><a href="#hd-schools">学区对比</a><a href="#hd-filters">六维筛选</a><a href="#hd-compare">楼栋 PK</a>
        </nav>
      </div>
    </section>
    <article id="lg-house-app" class="lp hd-app" aria-labelledby="hd-title">
      <Fragment set:html={body} />
      <noscript><p class="hd-no-script">请启用 JavaScript，以使用权重调节、户型筛选、PK 对比和学校图表。</p></noscript>
    </article>
    <nav class="cv-wrap hd-end" aria-label="页面导航"><a href="/life/house/">← 返回房产栏目</a><a href="#hd-title">回到顶部 ↑</a></nav>
  </main>
  <script is:inline src="/apps/life/house/longgang-home-school-decision/chart.umd.min.js" defer></script>
  <script is:inline src="/apps/life/house/longgang-home-school-decision/app.js" defer></script>
</Base>
