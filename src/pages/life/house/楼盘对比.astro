---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/house/楼盘对比/body.html?raw';
import '../../../legacy/life/house/楼盘对比/style.css';

const meta = {
  "title": "购房决策 · 九盘对比图表",
  "description": "布吉六盘、坂田四季花城、罗湖翠竹与香蜜湖参照的六维对比，并以不折旧含金量和十年脆弱度辅助决策。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head hp-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Life & Skills · House</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/life/house/">← 返回房产栏目</a>
    </div>
  </section>

  <article class="lp hp-article">
    <Fragment set:html={body} />
  </article>
</Base>
