---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/house/楼盘对比/body.html?raw';
import '../../../legacy/life/house/楼盘对比/style.css';

const meta = {
  "title": "购房决策 · 八盘对比图表",
  "description": "布吉六盘 + 坂田四季花城 + 香蜜湖参照 · 按学位、保值、流动性、居住品质、价格、通勤六维对比 · 含十年脆弱度光谱"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Life & Skills · House</div>
      <h1 class="page-title">{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <a class="crumb-back" href="/life/house/">← 返回房产栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
