---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/skills/network-ip-identity-guide/body.html?raw';
import '../../../legacy/life/skills/network-ip-identity-guide/style.css';

const meta = {
  title: '网络 IP 身份图谱｜从类型差异到平台识别',
  description: '系统梳理 IP 类型、网络归属、线路、ASN、BGP、设备指纹与平台风险识别机制。',
};
---
<Base title={`${meta.title} · Cavno`} description={meta.description}>
  <section class="cv-page-head nip-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Life & Skills · Skills</div>
      <h1 class="cv-page-title">网络 IP 身份图谱</h1>
      <p class="cv-lede">从 IP 类型、网络归属和出口线路出发，逐层理解 ASN、BGP、信誉、设备指纹与平台风险模型如何共同建立网络身份。</p>
      <a class="cv-crumb-back" href="/life/skills/">← 返回技能工具</a>
    </div>
  </section>

  <article class="lp nip-article">
    <Fragment set:html={body} />
  </article>
  <script>import '../../../legacy/life/skills/network-ip-identity-guide/script.js';</script>
</Base>
