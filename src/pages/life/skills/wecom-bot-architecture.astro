---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/skills/wecom-bot-architecture/body.html?raw';
import '../../../legacy/life/skills/wecom-bot-architecture/style.css';
const meta = { title: '企微 AI 机器人架构：一个人和一个智能体', description: '企微 AI 机器人的回调流水线、异步处理、知识库、问答、日报与好友自动通过架构分享。' };
---
<Base title={`${meta.title} · Cavno`} description={meta.description}>
