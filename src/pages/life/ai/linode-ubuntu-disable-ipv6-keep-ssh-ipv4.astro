---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/ai/linode-ubuntu-disable-ipv6-keep-ssh-ipv4/body.html?raw';
import '../../../legacy/life/ai/linode-ubuntu-disable-ipv6-keep-ssh-ipv4/style.css';

const meta = {
  title: 'Linode Cloud Firewall 与 Ubuntu 24.04 全面禁用 IPv6',
  description: '从 Linode Cloud Firewall、Ubuntu sysctl、双 SSH 会话验证到 Lish Console 恢复，建立保留 IPv4 SSH 的可验证、可回滚 IPv4-only 操作流程。',
};
---
<Base title={`${meta.title} · Cavno`} description={meta.description}>
  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Life & Skills · AI</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/life/ai/">← 返回 AI 栏目</a>
    </div>
  </section>

  <article class="lp ipv4-only-guide">
    <Fragment set:html={body} />
  </article>
</Base>
