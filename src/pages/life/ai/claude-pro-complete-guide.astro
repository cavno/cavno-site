---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/ai/claude-pro-complete-guide/body.html?raw';
import '../../../legacy/life/ai/claude-pro-complete-guide/style.css';

const meta = {
  title: 'Claude 稳定使用与订阅 · 原文整合',
  description: '将 Claude 风控完整长文与“搞定 Claude”可视化操作清单保存为站内静态备份，原始正文内容保持不变。',
};
---

<Base title={`${meta.title} · Cavno`} description={meta.description}>
  <section class="cv-page-head cpg-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Life & Skills · AI</div>
      <h1 class="cv-page-title">Claude 稳定使用与订阅</h1>
      <p class="cv-lede">完整长文、主图和可视化操作清单均已保存到站内；即使原始链接失效，正文仍可继续阅读。</p>
      <a class="cv-crumb-back" href="/life/ai/">← 返回 AI 栏目</a>
    </div>
  </section>

  <article class="lp cpg-article">
    <Fragment set:html={body} />
  </article>

  <script>
    import '../../../legacy/life/ai/claude-pro-complete-guide/script.js';
  </script>
</Base>
