---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/places/shenzhen-family-weekend-outing/body.html?raw';
import '../../../legacy/life/places/shenzhen-family-weekend-outing/style.css';
const title="深圳全区自然人文图谱 & 环深周末自驾决策系统";
const description="深圳10大行政区本地图谱、本地周末连玩打包路书、环深跨城微度假与双娃装备核对单";
---
<Base title={title+' · Cavno'} description={description}>
 <section class="cv-page-head ot-page-head"><div class="cv-wrap">
  <div class="cv-eyebrow">Life &amp; Skills · Places</div>
  <h1 class="cv-page-title" id="ot-title">{title}</h1>
  <a class="cv-crumb-back" href="/life/places/">← 返回地点栏目</a>
 </div></section>
 <article id="outing-app" class="lp ot-app" aria-labelledby="ot-title"><Fragment set:html={body} />
  <noscript><p>请启用 JavaScript，以使用点位筛选、预算沙盘、分时路书、周末自由拼装与装备清单。</p></noscript>
 </article>
 <nav class="cv-wrap ot-end" aria-label="页面导航"><a href="/life/places/">← 返回地点栏目</a><a href="#ot-title">回到顶部 ↑</a></nav>
 <script is:inline src="/apps/life/places/shenzhen-family-weekend-outing/app.js?v=19f68768711e" defer></script>
</Base>
