---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/driving/beginner-driving-practical-manual/body.html?raw';
import '../../../legacy/life/driving/beginner-driving-practical-manual/style.css';

const meta = {
  title: '新手驾驶实战说明书',
  description: '从基础操控、车感与动态车距，到变道、高架、环岛、倒车入库、侧方停车、地库和闹市通行，按 11 节实拍课程整理成可检索的完整驾驶手册。',
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Life & Skills · Driving</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/life/driving/">← 返回驾驶栏目</a>
    </div>
  </section>

  <article class="lp driving-manual">
    <Fragment set:html={body} />
  </article>
</Base>
