---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/life/orders/报单/body.html?raw';
import '../../../legacy/life/orders/报单/style.css';

const meta = {
  "title": "报单管理系统",
  "description": ""
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Life & Skills · Orders</div>
      <h1 class="page-title">{meta.title}</h1>
      
      <a class="crumb-back" href="/life/orders/">← 返回报单栏目</a>
