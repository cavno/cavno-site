---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/books/financial-alchemy-systems-analysis/body.html?raw';
import '../../../legacy/reading/books/financial-alchemy-systems-analysis/style.css';

const meta = {
  "title": "《金融炼金术》：一个反身复杂系统的解剖",
  "description": "以系统论重构乔治·索罗斯《金融炼金术》：反身性、繁荣—萧条、信用循环、政策反馈、投资方法及其理论边界。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Books</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/books/">← 返回书籍视察栏目</a>
    </div>
  </section>

  <article class="lp financial-alchemy">
    <Fragment set:html={body} />
  </article>
</Base>
