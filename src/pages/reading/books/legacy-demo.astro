---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/books/legacy-demo/body.html?raw';
import '../../../legacy/reading/books/legacy-demo/style.css';

const meta = {
  "title": "《债务危机》三阶段模型 · 去杠杆路径速览",
  "description": "从泡沫积累、顶部挤压到和谐去杠杆，梳理典型通缩性债务危机的阶段转换、识别信号与政策工具。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Reading & Thinking · Books</div>
      <h1 class="page-title">{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <a class="crumb-back" href="/reading/books/">← 返回书籍视察栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
