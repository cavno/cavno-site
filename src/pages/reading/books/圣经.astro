---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/books/圣经/body.html?raw';
import '../../../legacy/reading/books/圣经/style.css';

const meta = {
  "title": "圣经互动浏览器 · Biblical Atlas",
  "description": "一个交互式的圣经浏览工具——以五个维度（结构、时间线、故事、人物、主题）系统地呈现旧约与新约 66 卷书的内容与神学意义。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Reading & Thinking · Books</div>
      <h1 class="page-title">{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <a class="crumb-back" href="/reading/books/">← 返回书籍视察栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
