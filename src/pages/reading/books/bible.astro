---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';

const meta = {
  "title": "圣经互动浏览器 · Biblical Atlas",
  "description": "一个交互式的圣经浏览工具——以五个维度（结构、时间线、故事、人物、主题）系统地呈现旧约与新约 66 卷书的内容与神学意义。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Books</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/books/">← 返回书籍视察栏目</a>
    </div>
  </section>

  <section class="bible-embed" aria-label="圣经互动浏览器">
    <iframe
      id="bible-app"
      src="/apps/reading/books/bible/index.html"
      title="圣经互动浏览器 · Biblical Atlas"
      loading="eager"
    ></iframe>
  </section>

  <script>
    const frame = document.querySelector<HTMLIFrameElement>('#bible-app');
    if (frame) {
      const resizeFrame = () => {
        const documentElement = frame.contentDocument?.documentElement;
        if (!documentElement) return;
        frame.style.height = `${Math.max(760, documentElement.scrollHeight)}px`;
      };
      const observeFrame = () => {
        resizeFrame();
        const documentElement = frame.contentDocument?.documentElement;
        if (documentElement && 'ResizeObserver' in window) {
          new ResizeObserver(resizeFrame).observe(documentElement);
        }
      };
      frame.addEventListener('load', observeFrame);
      if (frame.contentDocument?.readyState === 'complete') observeFrame();
    }
  </script>

  <style>
    .bible-embed {
      width: min(100%, 1440px);
      margin: 0 auto 48px;
      overflow: hidden;
      background: #f5f0e6;
    }

    .bible-embed iframe {
      display: block;
      width: 100%;
      min-height: 760px;
      border: 0;
      background: #f5f0e6;
    }
  </style>
</Base>
