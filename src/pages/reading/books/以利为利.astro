---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/books/以利为利/body.html?raw';
import '../../../legacy/reading/books/以利为利/style.css';

const meta = {
  "title": "以利为利 · 结构重构 —— 周飞舟《财政关系与地方政府行为》",
  "description": "按周飞舟《以利为利：财政关系与地方政府行为》一书观点，对财政体制变迁、地方政府行为机制与后果链条的忠实结构化重构。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Reading & Thinking · Books</div>
      <h1 class="page-title">{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <a class="crumb-back" href="/reading/books/">← 返回书籍视察栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
