---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/books/制内市场/body.html?raw';
import '../../../legacy/reading/books/制内市场/style.css';

const meta = {
  "title": "制内市场 · 结构重构 —— 郑永年、黄彦杰《中国国家主导型政治经济学》",
  "description": "按郑永年、黄彦杰《制内市场：中国国家主导型政治经济学》一书观点，对其理论框架、历史演进顺序与当代运作机制的忠实结构化重构。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Reading & Thinking · Books</div>
      <h1 class="page-title">{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <a class="crumb-back" href="/reading/books/">← 返回书籍视察栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
