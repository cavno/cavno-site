import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/theology/western-christian-theology-evolution/body.html?raw';
import '../../../legacy/reading/theology/western-christian-theology-evolution/style.css';

const meta = {
  "title": "系统论视角下的西方基督教神学演化史",
  "description": "以物质、能量、信息、关系与边界五维系统模型，梳理西方基督教神学从犹太一神传统、教父与经院体系、宗教改革、科学启蒙挑战到现代复杂适应意义生态的演化。"
