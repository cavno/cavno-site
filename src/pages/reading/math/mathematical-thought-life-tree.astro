---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/math/mathematical-thought-life-tree/body.html?raw';
import '../../../legacy/reading/math/mathematical-thought-life-tree/style.css';

const meta = {
  "title": "数学思想的生命树｜从数量秩序到计算智能",
  "description": "以系统论梳理数学从数量测量、希腊证明、符号代数和微积分，到抽象结构、形式自反、复杂系统、网络与人工智能的九阶段演化。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Mathematics</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/math/">← 返回数学栏目</a>
    </div>
  </section>

  <article class="lp" data-theme="light">
    <Fragment set:html={body} />
  </article>
</Base>
