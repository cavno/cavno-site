---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/constraints-and-freedom/body.html?raw';
import '../../../legacy/reading/philosophy/constraints-and-freedom/style.css';

const meta = {
  "title": "约束与自由：一个系统论存在链的哲学考察",
  "description": "从约束、结构、关系、系统、秩序与主体的生成链条出发，考察自由如何出现，又如何被消费主义、绩效社会与治理技术重新收编。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp systems-history-essay">
    <Fragment set:html={body} />
  </article>
</Base>
