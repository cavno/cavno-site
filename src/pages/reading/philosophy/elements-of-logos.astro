---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/elements-of-logos/body.html?raw';
import '../../../legacy/reading/philosophy/elements-of-logos/style.css';

const meta = {
  "title": "逻各斯原本 · 公理推演图 Elements of Logos",
  "description": "《逻各斯原本》——欧几里得式的公理推演：四公理、两公设，派生十六组对立。交互式推演路径图。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
