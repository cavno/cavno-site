import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/二元悖论的张力-tension-web/body.html?raw';
import '../../../legacy/reading/philosophy/二元悖论的张力-tension-web/style.css';

const meta = {
  "title": "二元悖论的张力 · 本体论 · 认识论 · 方法论",
  "description": "从二元悖论的张力作为系统动力的视角，观察本体论、认识论、方法论的全部发展史。"
