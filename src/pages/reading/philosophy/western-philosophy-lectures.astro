---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/western-philosophy-lectures/body.html?raw';
import '../../../legacy/reading/philosophy/western-philosophy-lectures/style.css';

const meta = {
  "title": "西方哲学史考察 · 前六讲",
  "description": "梅春雷《西方哲学史考察十讲》前六讲思想脉络:一条主轴、六条贯穿线、六讲全文要义、概念谱系、张力总表、人物长廊。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
