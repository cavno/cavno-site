---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/sixteen-oppositions-chain-reaction/body.html?raw';
import '../../../legacy/reading/philosophy/sixteen-oppositions-chain-reaction/style.css';

const meta = {
  "title": "十六组对立 · 连锁反应链 — 缺口·填补·新缺口",
  "description": "不画对立本身，画它们之间的驱动力：每一步堵了什么洞、又凿开了什么新洞——一条从"
