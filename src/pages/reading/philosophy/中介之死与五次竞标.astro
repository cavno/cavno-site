---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/中介之死与五次竞标/body.html?raw';
import '../../../legacy/reading/philosophy/中介之死与五次竞标/style.css';

const meta = {
  "title": "中介之死与五次竞标 · 近代哲学结构图",
  "description": "二分表为左列，笛卡尔到康德的标书为节点，康德的形式之桥收束——近代哲学=中介(神)之死后为二分寻找替代焊点的连续竞标。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="page-head">
    <div class="wrap">
      <div class="eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="page-title">{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <a class="crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
