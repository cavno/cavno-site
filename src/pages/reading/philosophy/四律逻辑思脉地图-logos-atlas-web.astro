---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/四律逻辑思脉地图-logos-atlas-web/body.html?raw';
import '../../../legacy/reading/philosophy/四律逻辑思脉地图-logos-atlas-web/style.css';

const meta = {
  "title": "四律 · 逻辑思脉地图（科普勒斯顿全谱系）Atlas Logoi",
  "description": "把同一律、矛盾律、排中律、充足理由律当作可装可卸的"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
