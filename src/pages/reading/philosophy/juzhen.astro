---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/philosophy/juzhen/body.html?raw';
import '../../../legacy/reading/philosophy/juzhen/style.css';

const meta = {
  "title": "公理组合矩阵 · Axiom Combinatorics",
  "description": "把四条逻辑律当作一个集合/矩阵，每条取持守·极致·松动·否弃·限定·悬置·不涉之一；不同的排列组合对应一种哲学倾向——打破历史线，按公理构型聚类。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Philosophy</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/philosophy/">← 返回哲学栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
