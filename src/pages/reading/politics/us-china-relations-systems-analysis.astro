---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/politics/us-china-relations-systems-analysis/body.html?raw';
import '../../../styles/politics-essay.css';

const meta = {
  "title": "中美关系演化的系统论分析",
  "description": "从敌对隔离、战略接近与经济共生，追踪中美关系如何演化为技术、安全、联盟和供应链多网络耦合的长期竞争系统。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Politics</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/politics/">← 返回政治栏目</a>
    </div>
  </section>

  <article class="lp politics-essay">
    <Fragment set:html={body} />
  </article>
</Base>
