---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/financial-system/body.html?raw';
import '../../../styles/systems-essay.css';

const meta = {
  "title": "金融系统发展史",
  "description": "金融史不是产品清单，而是人类不断扩大“可承诺的未来”、把现实权利转化为可记录、可计量、可交易结构的历史。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>
  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Economics</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/economics/">← 返回经济学栏目</a>
    </div>
  </section>

  <article class="lp systems-essay">
    <Fragment set:html={body} />
  </article>
  <script is:inline src="/scripts/systems-essay.js" defer></script>
</Base>
