---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/information-evolution/body.html?raw';
import '../../../styles/systems-essay.css';

const meta = {
  "title": "信息演化史",
  "description": "信息史从可区分状态、相关性和物理记忆开始，逐步进入遗传、神经、语言、计算与人工智能。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>
  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Science</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/science/">← 返回自然科学栏目</a>
    </div>
  </section>

  <article class="lp systems-essay">
    <Fragment set:html={body} />
  </article>
  <script is:inline src="/scripts/systems-essay.js" defer></script>
</Base>
