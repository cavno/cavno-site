---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/business-management-systems-evolution/body.html?raw';
import '../../../legacy/reading/thinking/business-management-systems-evolution/style.css';

const meta = {
  "title": "企业经营管理学的发展演化：系统论视角",
  "description": "从开放复杂适应系统视角，梳理企业经营管理从科学管理、战略竞争、精益与组织学习，到数据和 AI 增强型自适应经营系统的演化。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Thinking</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/thinking/">← 返回思考栏目</a>
    </div>
  </section>

  <article class="lp business-management-systems-page">
    <Fragment set:html={body} />
  </article>
</Base>
