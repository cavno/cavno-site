---
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/human-body-system/body.html?raw';
import '../../../styles/systems-essay.css';

const meta = {
  "title": "人体系统",
  "description": "人体不是器官清单，而是细胞、组织、器官、神经、内分泌、免疫和微生物群在能量流与信息流中共同维持的动态整体。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>
  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Thinking</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/thinking/">← 返回思考栏目</a>
    </div>
  </section>

  <article class="lp systems-essay">
    <Fragment set:html={body} />
  </article>
  <script is:inline src="/scripts/systems-essay.js" defer></script>
</Base>
