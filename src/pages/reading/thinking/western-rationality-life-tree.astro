---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/western-rationality-life-tree/body.html?raw';
import '../../../legacy/reading/thinking/western-rationality-life-tree/style.css';

const meta = {
  "title": "西方理性的生命树｜从闭合证明系统到自我演化的认知生态",
  "description": "从古希腊到 AI，以根、树干、分叉、闭合、张力、生成、反馈、剪枝、嫁接与认知生态系统完整重构西方理性的演化机制。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Thinking</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/thinking/">← 返回思考栏目</a>
    </div>
  </section>

  <article class="lp">
    <Fragment set:html={body} />
  </article>
</Base>
