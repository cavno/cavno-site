---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/human-brain-evolution/body.html?raw';
import '../../../legacy/reading/thinking/human-brain-evolution/style.css';

const meta = {
  "title": "人的大脑进化过程：系统论视角",
  "description": "从感觉—运动闭环到脑—身体—社会—文化—技术耦合，系统梳理人脑如何在能量、发育与生态约束中演化。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Thinking</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/thinking/">← 返回思考栏目</a>
    </div>
  </section>

  <article class="lp human-brain-evolution-page">
    <Fragment set:html={body} />
  </article>
</Base>
