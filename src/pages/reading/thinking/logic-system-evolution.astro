---
// 由 scripts/convert.mjs 生成，可自由手工精修
import Base from '../../../layouts/Base.astro';
import body from '../../../legacy/reading/thinking/logic-system-evolution/body.html?raw';
import '../../../legacy/reading/thinking/logic-system-evolution/style.css';

const meta = {
  "title": "逻辑：一个认知系统的演化史",
  "description": "从系统论重构逻辑的发展演化史：从区分与约束，到推理、生成、更新与元控制。"
};
---
<Base title={meta.title + ' · Cavno'} description={meta.description}>

  <section class="cv-page-head">
    <div class="cv-wrap">
      <div class="cv-eyebrow">Reading & Thinking · Thinking</div>
      <h1 class="cv-page-title">{meta.title}</h1>
      <p class="cv-lede">{meta.description}</p>
      <a class="cv-crumb-back" href="/reading/thinking/">← 返回思考栏目</a>
    </div>
  </section>

  <article class="lp logic-evolution-page">
    <Fragment set:html={body} />
  </article>
</Base>
