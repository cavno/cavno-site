---
import Base from '../layouts/Base.astro';
import ItemCard from '../components/ItemCard.astro';
import nav from '../content/nav.json';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  const paths: { params: { path: string }; props: { sectionSlug: string; subSlug: string | null } }[] = [];
  for (const s of nav.sections) {
    paths.push({ params: { path: s.slug }, props: { sectionSlug: s.slug, subSlug: null } });
    for (const sub of s.subsections) {
      paths.push({
        params: { path: `${s.slug}/${sub.slug}` },
        props: { sectionSlug: s.slug, subSlug: sub.slug },
      });
    }
  }
  return paths;
}

const { sectionSlug, subSlug } = Astro.props;
const section = nav.sections.find((s) => s.slug === sectionSlug)!;
const sub = subSlug ? section.subsections.find((x) => x.slug === subSlug) ?? null : null;

const all = (await getCollection('items'))
  .filter((i) => i.data.section === sectionSlug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const items = sub ? all.filter((i) => i.data.subsection === sub.slug) : all;

const ym = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const tagFor = (slug: string) =>
  section.subsections.find((x) => x.slug === slug)?.en ?? (slug || '未分类');

const pageTitle = sub
  ? `${sub.en} · ${section.en} · Cavno`
  : `${section.en} · Cavno`;
const desc = (sub?.desc || section.desc) ?? '';
---
<Base title={pageTitle} description={desc}>

<section class="page-head">
  <div class="wrap">
    <div class="eyebrow">{section.en} · {section.zh}</div>
    <h1 class="page-title">
      {sub ? sub.en : section.en}
      <small>{sub ? sub.zh : section.zh}</small>
    </h1>
    <p class="lede">{desc}</p>

    <div class="chip-row filter-row">
      <a class:list={['chip', { active: !sub }]} href={`/${section.slug}/`}>全部</a>
      {section.subsections.map((x) => (
        <a class:list={['chip', { active: sub?.slug === x.slug }]} href={`/${section.slug}/${x.slug}/`}>
          {x.en}{x.zh !== x.en ? ` ${x.zh}` : ''}
        </a>
      ))}
    </div>
  </div>
</section>

<section class="grid-pad">
  <div class="wrap">
    <div class="recent-grid">
      {items.length > 0 ? (
        items.map((i) => (
          <ItemCard
            href={i.data.href}
            title={i.data.title}
            summary={i.data.summary}
            tag={tagFor(i.data.subsection)}
            date={ym(i.data.date)}
          />
        ))
      ) : (
        <div class="empty">
          此栏目暂无条目。<br />
          在 <code>/admin</code> 后台新增，或运行 <code>node scripts/migrate.mjs &lt;源目录&gt; --section={section.slug}{sub ? ` --subsection=${sub.slug}` : ''}</code> 批量导入。
        </div>
      )}
    </div>
  </div>
</section>

</Base>
