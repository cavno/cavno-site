---
import Base from '../layouts/Base.astro';
import legacyRouteRedirects from '../data/legacy-route-redirects.json';
---
<Base title="404 · Cavno">
  <script is:inline define:vars={{ legacyRouteRedirects }}>
    try {
      const pathname = decodeURI(window.location.pathname).replace(/\/+$/, '/') || '/';
      const target = legacyRouteRedirects[pathname];
      if (target) window.location.replace(target + window.location.search + window.location.hash);
    } catch {}
  </script>
  <div class="cv-notfound">
    <div>
      <h1>404</h1>
      <p>这个地址不存在，或页面已迁移。</p>
      <a class="cv-btn cv-btn-ink" href="/">返回首页</a>
    </div>
  </div>
</Base>
