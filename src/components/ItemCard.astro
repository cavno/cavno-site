---
import { derivePresentation } from '../lib/content-presentation';

interface Props {
  href: string;
  title: string;
  summary?: string;
  tag: string;
  date: string;
  tags?: string[];
  section?: string;
  subsection?: string;
  body?: string;
}
const {
  href,
  title,
  summary = '',
  tag,
  date,
  tags = [],
  section = '',
  subsection = '',
  body = '',
} = Astro.props;
const external = /^https?:\/\//.test(href);
const cover = derivePresentation({ title, summary, tags, section, subsection, body });
---
<a
  class="cv-item"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  aria-label={title}
>
  <div
    class={`cv-auto-cover cv-cover-v${cover.variant} cv-cover-motif-${cover.motif}`}
    style={`--cv-cover-h:${cover.hue};`}
    aria-hidden="true"
  >
    <div class={`cv-cover-art cv-art-${cover.motif}`}>
      <i class="cv-art-a"></i>
      <i class="cv-art-b"></i>
      <i class="cv-art-c"></i>
      <i class="cv-art-d"></i>
      <i class="cv-art-e"></i>
    </div>
    <div class="cv-cover-title">
      <strong>{cover.title}</strong>
    </div>
  </div>
  <div class="cv-item-body">
    <div class="cv-item-meta"><span class="cv-tag">{tag}</span><span class="cv-date">{date}</span></div>
    <h3 class="cv-item-title">{title}</h3>
    {cover.summary && <p>{cover.summary}</p>}
  </div>
</a>
