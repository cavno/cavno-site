---
import { derivePresentation, htmlToPlainText } from '../lib/content-presentation';
import { coverClassName, coverStyle } from '../lib/cover-design';

interface Props {
  href: string;
  title: string;
  summary?: string;
  tag: string;
  date: string;
  tags?: string[];
  section?: string;
  subsection?: string;
  body?: string;
}
const {
  href,
  title,
  summary = '',
  tag,
  date,
  tags = [],
  section = '',
  subsection = '',
  body = '',
} = Astro.props;
const external = /^https?:\/\//.test(href);
const cover = derivePresentation({ href, title, summary, tags, section, subsection, body });
const plainBody = htmlToPlainText(body);
const hanCount = (plainBody.match(/\p{Script=Han}/gu) ?? []).length;
const latinWordCount = (plainBody.match(/[A-Za-z0-9]+(?:['’-][A-Za-z0-9]+)*/g) ?? []).length;
const contentUnits = hanCount + latinWordCount;
const roundedUnits = contentUnits < 1000
  ? Math.max(10, Math.round(contentUnits / 10) * 10)
  : Math.round(contentUnits / 100) * 100;
const countLabel = roundedUnits >= 10000
  ? `${(roundedUnits / 10000).toFixed(roundedUnits >= 100000 ? 0 : 1).replace(/\.0$/, '')} 万字`
  : `${new Intl.NumberFormat('zh-CN').format(roundedUnits)} 字`;
const readingMinutes = Math.max(1, Math.ceil(hanCount / 350 + latinWordCount / 200));
---
<a
  class="cv-item"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  aria-label={title}
>
  <div
    class={`cv-auto-cover ${coverClassName(cover)}`}
    style={coverStyle(cover)}
    aria-hidden="true"
  >
    <div class={`cv-cover-art cv-art-${cover.motif}`}>
      <i class="cv-art-a"></i>
      <i class="cv-art-b"></i>
      <i class="cv-art-c"></i>
      <i class="cv-art-d"></i>
      <i class="cv-art-e"></i>
    </div>
  </div>
  <div class="cv-item-body">
    <h3 class="cv-item-title">{title}</h3>
    {cover.summary && <p class="cv-item-summary">{cover.summary}</p>}
    <div class="cv-item-details" aria-label={`${tag}，日期 ${date}，正文约 ${countLabel}，预计阅读 ${readingMinutes} 分钟`}>
      <span class="cv-tag">{tag}</span>
      <span class="cv-date">{date}</span>
      <span>约 {countLabel}</span>
      <span>阅读 {readingMinutes} 分钟</span>
    </div>
  </div>
</a>
