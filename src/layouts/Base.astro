---
import '../styles/global.css';
import nav from '../content/nav.json';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Cavno · 个人公开工作台',
  description = '投资、阅读与思考、生活与技能、工作工具——整合于同一域名之下的个人公开工作台。',
} = Astro.props;
const year = new Date().getFullYear();

// 当前路径 → 高亮对应的一级板块与二级栏目（全站公共导航的"我在哪"）
const _p = Astro.url.pathname;
const norm = _p.endsWith('/') ? _p : _p + '/';
const isSec = (slug: string) => norm.startsWith(`/${slug}/`);
const isSub = (slug: string, sub: string) => norm.startsWith(`/${slug}/${sub}/`);
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- 非阻塞加载：fonts.googleapis.com 在大陆不可达，阻塞式 <link> 会拖住首屏渲染。
       取不到时回落到本机 Songti SC / PingFang SC（见 --serif / --sans 字体栈），中文照常显示。 -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap"
        rel="stylesheet" media="print" onload="this.media='all';this.onload=null" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" /></noscript>
</head>
<body>

<header class="cv-site-head" id="cvSiteHead">
  <div class="cv-wrap cv-head-in">
    <a class="cv-brand" href="/">Cavno<span class="cv-bdot">.</span></a>

    <nav class="cv-primary" aria-label="主导航">
      {nav.sections.map((s) => (
        <div class="cv-nav-item">
          <button class:list={['cv-nav-btn', { active: isSec(s.slug) }]} aria-expanded="false" aria-current={isSec(s.slug) ? 'true' : undefined}>{s.en}
            <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="cv-panel">
            {s.planned && <div class="cv-group-label">二级栏目 · 拟设</div>}
            {s.subsections.map((sub) => (
              <a href={`/${s.slug}/${sub.slug}/`} class:list={{ active: isSub(s.slug, sub.slug) }} aria-current={isSub(s.slug, sub.slug) ? 'page' : undefined}>
                <div class="cv-p-title">{sub.en}{sub.zh !== sub.en && <small>{sub.zh}</small>}</div>
                {sub.desc && <div class="cv-p-desc">{sub.desc}</div>}
              </a>
            ))}
            <a class="cv-panel-home" href={`/${s.slug}/`}>进入 {s.zh} 板块 →</a>
          </div>
        </div>
      ))}
    </nav>

    <div class="cv-head-actions">
      <a class="cv-btn cv-btn-line" href="https://github.com/cavno" target="_blank" rel="noopener">GitHub</a>
      <a class="cv-btn cv-btn-ink" href="/#recent">最近更新</a>
    </div>

    <button class="cv-burger" id="cvBurger" aria-label="打开菜单" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="cv-drawer" id="cvDrawer" role="dialog" aria-label="站点菜单">
  <div class="cv-drawer-top">
    <span class="cv-brand">Cavno<span class="cv-bdot">.</span></span>
    <button class="cv-drawer-close" id="cvDrawerClose" aria-label="关闭菜单">×</button>
  </div>
  {nav.sections.map((s) => (
    <div class:list={['cv-acc', { open: isSec(s.slug) }]}>
      <button class="cv-acc-btn">{s.en}
        <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="cv-acc-body">
        <a href={`/${s.slug}/`}>{s.zh}板块首页</a>
        {s.subsections.map((sub) => (
          <a href={`/${s.slug}/${sub.slug}/`} class:list={{ active: isSub(s.slug, sub.slug) }}>{sub.en}{sub.zh !== sub.en ? ` ${sub.zh}` : ''}</a>
        ))}
      </div>
    </div>
  ))}
  <a class="cv-btn cv-btn-ink" href="/#recent">浏览最近更新</a>
</div>

<main id="cvMain">
  <slot />
</main>

<footer class="cv-site-foot">
  <div class="cv-foot-in">
    <div class="cv-foot-grid">
      <div>
        <div class="cv-foot-brand">Cavno<span class="cv-bdot">.</span></div>
        <p class="cv-foot-blurb">一个人的公开工作台：投资、阅读与思考、生活与技能、工作工具。静态构建，内容即仓库。</p>
      </div>
      {nav.sections.map((s) => (
        <div>
          <h4><a href={`/${s.slug}/`}>{s.en}</a></h4>
          {s.subsections.map((sub) => (
            <a href={`/${s.slug}/${sub.slug}/`}>{sub.en}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="cv-foot-bottom">
      <span>© {year} Cavno · 用 Astro 构建，托管于 Cloudflare Pages</span>
      <span>
        <a href="https://github.com/cavno" target="_blank" rel="noopener">GitHub</a>
      </span>
    </div>
  </div>
</footer>

<script>
  // 顶栏滚动描边
  const head = document.getElementById('cvSiteHead');
  const onScroll = () => head?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 桌面端下拉：点击开合（触屏友好），hover 由 CSS 处理
  const items = Array.from(document.querySelectorAll('.cv-nav-item'));
  const closeAll = () => items.forEach((o) => {
    o.classList.remove('open');
    o.querySelector('.cv-nav-btn')?.setAttribute('aria-expanded', 'false');
  });
  items.forEach((it) => {
    const btn = it.querySelector('.cv-nav-btn');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !it.classList.contains('open');
      closeAll();
      if (willOpen) { it.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });
  document.addEventListener('click', closeAll);

  // 移动端抽屉
  const cvDrawer = document.getElementById('cvDrawer');
  const cvBurger = document.getElementById('cvBurger');
  const openDrawer = () => { cvDrawer?.classList.add('open'); document.body.classList.add('lock'); cvBurger?.setAttribute('aria-expanded', 'true'); };
  const closeDrawer = () => { cvDrawer?.classList.remove('open'); document.body.classList.remove('lock'); cvBurger?.setAttribute('aria-expanded', 'false'); };
  cvBurger?.addEventListener('click', openDrawer);
  document.getElementById('cvDrawerClose')?.addEventListener('click', closeDrawer);
  cvDrawer?.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') closeDrawer(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeAll(); closeDrawer(); } });

  // 抽屉内手风琴
  document.querySelectorAll('.cv-acc-btn').forEach((b) => {
    b.addEventListener('click', () => b.parentElement?.classList.toggle('open'));
  });
</script>
</body>
</html>
