---
import '../styles/global.css';
import nav from '../content/nav.json';
import GlobalSearch from '../components/GlobalSearch.astro';
import { getCollection } from 'astro:content';
import { compareItemsNewestFirst } from '../lib/content-order';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Cavno · 个人公开工作台',
  description = '投资、阅读与思考、生活与技能、工作工具——整合于同一域名之下的个人公开工作台。',
} = Astro.props;
const year = new Date().getFullYear();

// 当前路径 → 高亮对应的一级板块与二级栏目（全站公共导航的"我在哪"）
const _p = Astro.url.pathname;
const norm = _p.endsWith('/') ? _p : _p + '/';
const isSec = (slug: string) => norm.startsWith(`/${slug}/`);
const isSub = (slug: string, sub: string) => norm.startsWith(`/${slug}/${sub}/`);
const navEntries = (await getCollection('items')).sort(compareItemsNewestFirst);
const recentFor = (section: string, subsection: string) =>
  navEntries.filter((entry) => entry.data.section === section && entry.data.subsection === subsection).slice(0, 3);
const panelColumns = (count: number) => Math.min(4, Math.max(1, count));

/* Working 板块由 Cloudflare Access（Zero Trust）在边缘鉴权，仓库内不含任何口令。
   此处仅额外声明不被搜索引擎收录，作为纵深防御（见 docs/ACCESS-SETUP.md）。 */
const restricted = norm.startsWith('/working/');
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- 非阻塞加载：fonts.googleapis.com 在大陆不可达，阻塞式 <link> 会拖住首屏渲染。
       取不到时回落到本机 Songti SC / PingFang SC（见 --serif / --sans 字体栈），中文照常显示。 -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap"
        rel="stylesheet" media="print" onload="this.media='all';this.onload=null" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" /></noscript>
  {restricted && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>

<header class="cv-site-head" id="cvSiteHead">
  <div class="cv-wrap cv-head-in">
    <a class="cv-brand" href="/">Cavno<span class="cv-bdot">.</span></a>

    <nav class="cv-primary" aria-label="主导航">
      {nav.sections.map((s) => (
        <div class="cv-nav-item" style={`--cv-mega-columns:${panelColumns(s.subsections.length)}`}>
          <button class:list={['cv-nav-btn', { active: isSec(s.slug) }]} id={`cvNav-${s.slug}`} aria-expanded="false" aria-controls={`cvMega-${s.slug}`} aria-current={isSec(s.slug) ? 'true' : undefined}>{s.en}
            <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="cv-mega-panel" id={`cvMega-${s.slug}`} aria-labelledby={`cvNav-${s.slug}`}>
            <div class="cv-mega-head">
              <div>
                <span class="cv-mega-kicker">{s.zh} · CONTENT MAP</span>
                <p>{s.desc}</p>
              </div>
              <a class="cv-mega-overview" href={`/${s.slug}/`}>查看全部 {s.zh}内容 <span aria-hidden="true">↗</span></a>
            </div>
            <div class="cv-mega-grid">
              {s.subsections.map((sub) => (
                <div class:list={['cv-mega-group', { active: isSub(s.slug, sub.slug) }]}>
                  <a class="cv-mega-group-title" href={`/${s.slug}/${sub.slug}/`} aria-current={isSub(s.slug, sub.slug) ? 'page' : undefined}>
                    <span>{sub.en}</span><small>{sub.zh}</small><i aria-hidden="true">↗</i>
                  </a>
                  {sub.desc && <p class="cv-mega-group-desc">{sub.desc}</p>}
                  <div class="cv-mega-links">
                    {recentFor(s.slug, sub.slug).map((entry) => (
                      <a href={entry.data.href}><span>{entry.data.title}</span><i aria-hidden="true">→</i></a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
      {nav.utilityMenus.map((menu) => (
        <div class="cv-nav-item" style={`--cv-mega-columns:${panelColumns(menu.groups.length)}`}>
          <button class="cv-nav-btn" id={`cvNav-${menu.slug}`} aria-expanded="false" aria-controls={`cvMega-${menu.slug}`}>{menu.en}
            <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="cv-mega-panel cv-mega-panel-utility" id={`cvMega-${menu.slug}`} aria-labelledby={`cvNav-${menu.slug}`}>
            <div class="cv-mega-head">
              <div>
                <span class="cv-mega-kicker">{menu.zh} · QUICK ACCESS</span>
                <p>{menu.desc}</p>
              </div>
            </div>
            <div class="cv-mega-grid">
              {menu.groups.map((group) => (
                <div class="cv-mega-group">
                  <a class="cv-mega-group-title" href={group.href}>
                    <span>{group.en}</span><small>{group.zh}</small><i aria-hidden="true">↗</i>
                  </a>
                  <div class="cv-mega-links cv-mega-links-utility">
                    {group.links.map((link) => (
                      <a href={link.href}><span>{link.title}</span><i aria-hidden="true">→</i></a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
      <a class="cv-nav-link" href="/#about">About</a>
    </nav>

    <div class="cv-head-actions">
      <button class="cv-nav-search cv-search-open" type="button" data-cv-search-open aria-label="搜索全站" aria-haspopup="dialog" aria-controls="cvGlobalSearch" aria-expanded="false">
        <span class="cv-search-open-icon" aria-hidden="true"></span>
        <span>Search</span>
      </button>
    </div>

    <button class="cv-burger" id="cvBurger" aria-label="打开菜单" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="cv-drawer" id="cvDrawer" role="dialog" aria-label="站点菜单">
  <div class="cv-drawer-top">
    <span class="cv-brand">Cavno<span class="cv-bdot">.</span></span>
    <button class="cv-drawer-close" id="cvDrawerClose" aria-label="关闭菜单">×</button>
  </div>
  {nav.sections.map((s) => (
    <div class:list={['cv-acc', { open: isSec(s.slug) }]}>
      <button class="cv-acc-btn" aria-expanded={isSec(s.slug) ? 'true' : 'false'}>{s.en}
        <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="cv-acc-body">
        <a class="cv-drawer-overview" href={`/${s.slug}/`}>查看全部 {s.zh}内容 <span aria-hidden="true">↗</span></a>
        {s.subsections.map((sub) => (
          <div class="cv-drawer-group">
            <a class:list={['cv-drawer-group-title', { active: isSub(s.slug, sub.slug) }]} href={`/${s.slug}/${sub.slug}/`}>{sub.en}<small>{sub.zh}</small></a>
            {recentFor(s.slug, sub.slug).slice(0, 2).map((entry) => <a class="cv-drawer-entry" href={entry.data.href}>{entry.data.title}</a>)}
          </div>
        ))}
      </div>
    </div>
  ))}
  {nav.utilityMenus.map((menu) => (
    <div class="cv-acc">
      <button class="cv-acc-btn" aria-expanded="false">{menu.en}
        <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="cv-acc-body">
        {menu.groups.map((group) => (
          <div class="cv-drawer-group">
            <a class="cv-drawer-group-title" href={group.href}>{group.en}<small>{group.zh}</small></a>
            {group.links.map((link) => <a class="cv-drawer-entry" href={link.href}>{link.title}</a>)}
          </div>
        ))}
      </div>
    </div>
  ))}
  <a class="cv-drawer-direct" href="/#about">About <span>关于本站</span><i aria-hidden="true">↗</i></a>
  <button class="cv-btn cv-btn-line cv-drawer-search" type="button" data-cv-search-open aria-haspopup="dialog" aria-controls="cvGlobalSearch" aria-expanded="false">
    <span class="cv-search-open-icon" aria-hidden="true"></span>
    搜索全站
  </button>
</div>

<GlobalSearch />

<main id="cvMain">
  <slot />
</main>
<footer class="cv-site-foot" id="about">
  <div class="cv-foot-in">
    <div class="cv-foot-grid">
      <div>
        <div class="cv-foot-brand">Cavno<span class="cv-bdot">.</span></div>
        <p class="cv-foot-blurb">一个人的公开工作台：围绕投资、思想、生活与工作，持续整理问题、证据、模型和方法。</p>
      </div>
      {nav.sections.map((s) => (
        <div>
          <h4><a href={`/${s.slug}/`}>{s.en}</a></h4>
          {s.subsections.map((sub) => (
            <a href={`/${s.slug}/${sub.slug}/`}>{sub.en}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="cv-foot-bottom">
      <span>© {year} Cavno · 记录思考，沉淀方法</span>
    </div>
  </div>
</footer>

<script>
  // 顶栏滚动描边
  const head = document.getElementById('cvSiteHead');
  const onScroll = () => head?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 桌面端多级导航：点击开合，hover / focus-within 由 CSS 处理
  const items = Array.from(document.querySelectorAll('.cv-site-head .cv-nav-item'));
  const closeAll = () => items.forEach((o) => {
    o.classList.remove('open');
    o.querySelector('.cv-nav-btn')?.setAttribute('aria-expanded', 'false');
  });
  items.forEach((it) => {
    const btn = it.querySelector('.cv-nav-btn');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !it.classList.contains('open');
      closeAll();
      if (willOpen) { it.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });
  document.querySelectorAll('.cv-site-head [data-cv-search-open]').forEach((button) => button.addEventListener('click', closeAll));
  document.addEventListener('click', closeAll);

  // 移动端抽屉
  const cvDrawer = document.getElementById('cvDrawer');
  const cvBurger = document.getElementById('cvBurger');
  const drawerClose = document.getElementById('cvDrawerClose');
  const openDrawer = () => { cvDrawer?.classList.add('open'); document.body.classList.add('lock'); cvBurger?.setAttribute('aria-expanded', 'true'); drawerClose?.focus(); };
  const closeDrawer = (restoreFocus = false) => { cvDrawer?.classList.remove('open'); document.body.classList.remove('lock'); cvBurger?.setAttribute('aria-expanded', 'false'); if (restoreFocus) cvBurger?.focus(); };
  cvBurger?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', () => closeDrawer(true));
  cvDrawer?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) closeDrawer(); });
  cvDrawer?.querySelector('[data-cv-search-open]')?.addEventListener('click', () => closeDrawer());
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeAll(); if (cvDrawer?.classList.contains('open')) closeDrawer(true); } });

  // 抽屉内手风琴
  document.querySelectorAll('.cv-acc-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.parentElement?.classList.toggle('open') ?? false;
      b.setAttribute('aria-expanded', String(open));
    });
  });
</script>
</body>
</html>
