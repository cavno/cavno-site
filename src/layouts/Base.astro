---
import '../styles/global.css';
import nav from '../content/nav.json';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Cavno · 个人公开工作台',
  description = '投资、阅读与思考、生活与技能、工作工具——整合于同一域名之下的个人公开工作台。',
} = Astro.props;
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" />
</head>
<body>

<header class="site-head" id="siteHead">
  <div class="wrap head-in">
    <a class="brand" href="/">Cavno<span class="dot">.</span></a>

    <nav class="primary" aria-label="主导航">
      {nav.sections.map((s) => (
        <div class="nav-item">
          <button class="nav-btn" aria-expanded="false">{s.en}
            <svg class="chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="panel">
            {s.planned && <div class="group-label">二级栏目 · 拟设</div>}
            {s.subsections.map((sub) => (
              <a href={`/${s.slug}/${sub.slug}/`}>
                <div class="p-title">{sub.en}{sub.zh !== sub.en && <small>{sub.zh}</small>}</div>
                {sub.desc && <div class="p-desc">{sub.desc}</div>}
              </a>
            ))}
            <a class="panel-home" href={`/${s.slug}/`}>进入 {s.zh} 板块 →</a>
          </div>
        </div>
      ))}
    </nav>

    <div class="head-actions">
      <a class="btn btn-line" href="https://github.com/cavno" target="_blank" rel="noopener">GitHub</a>
      <a class="btn btn-ink" href="/#recent">最近更新</a>
    </div>

    <button class="burger" id="burger" aria-label="打开菜单" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" role="dialog" aria-label="站点菜单">
  <div class="drawer-top">
    <span class="brand">Cavno<span class="dot">.</span></span>
    <button class="drawer-close" id="drawerClose" aria-label="关闭菜单">×</button>
  </div>
  {nav.sections.map((s) => (
    <div class="acc">
      <button class="acc-btn">{s.en}
        <svg class="chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="acc-body">
        <a href={`/${s.slug}/`}>{s.zh}板块首页</a>
        {s.subsections.map((sub) => (
          <a href={`/${s.slug}/${sub.slug}/`}>{sub.en}{sub.zh !== sub.en ? ` ${sub.zh}` : ''}</a>
        ))}
      </div>
    </div>
  ))}
  <a class="btn btn-ink" href="/#recent">浏览最近更新</a>
</div>

<main id="main">
  <slot />
</main>

<footer class="site-foot">
  <div class="foot-in">
    <div class="foot-grid">
      <div>
        <div class="foot-brand">Cavno<span class="dot">.</span></div>
        <p class="foot-blurb">一个人的公开工作台：投资、阅读与思考、生活与技能、工作工具。静态构建，内容即仓库。</p>
      </div>
      {nav.sections.map((s) => (
        <div>
          <h4><a href={`/${s.slug}/`}>{s.en}</a></h4>
          {s.subsections.map((sub) => (
            <a href={`/${s.slug}/${sub.slug}/`}>{sub.en}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="foot-bottom">
      <span>© {year} Cavno · 用 Astro 构建，托管于 Cloudflare Pages</span>
      <span>
        <a href="https://github.com/cavno" target="_blank" rel="noopener">GitHub</a>
      </span>
    </div>
  </div>
</footer>

<script>
  // 顶栏滚动描边
  const head = document.getElementById('siteHead');
  const onScroll = () => head?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 桌面端下拉：点击开合（触屏友好），hover 由 CSS 处理
  const items = Array.from(document.querySelectorAll('.nav-item'));
  const closeAll = () => items.forEach((o) => {
    o.classList.remove('open');
    o.querySelector('.nav-btn')?.setAttribute('aria-expanded', 'false');
  });
  items.forEach((it) => {
    const btn = it.querySelector('.nav-btn');
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !it.classList.contains('open');
      closeAll();
      if (willOpen) { it.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });
  document.addEventListener('click', closeAll);

  // 移动端抽屉
  const drawer = document.getElementById('drawer');
  const burger = document.getElementById('burger');
  const openDrawer = () => { drawer?.classList.add('open'); document.body.classList.add('lock'); burger?.setAttribute('aria-expanded', 'true'); };
  const closeDrawer = () => { drawer?.classList.remove('open'); document.body.classList.remove('lock'); burger?.setAttribute('aria-expanded', 'false'); };
  burger?.addEventListener('click', openDrawer);
  document.getElementById('drawerClose')?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') closeDrawer(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeAll(); closeDrawer(); } });

  // 抽屉内手风琴
  document.querySelectorAll('.acc-btn').forEach((b) => {
    b.addEventListener('click', () => b.parentElement?.classList.toggle('open'));
  });
</script>
</body>
</html>
