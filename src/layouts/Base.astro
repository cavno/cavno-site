---
import '../styles/global.css';
import nav from '../content/nav.json';
import GlobalSearch from '../components/GlobalSearch.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Cavno · 个人公开工作台',
  description = '投资、阅读与思考、生活与技能、工作工具——整合于同一域名之下的个人公开工作台。',
} = Astro.props;
const year = new Date().getFullYear();

// 当前路径 → 高亮对应的一级板块与二级栏目（全站公共导航的"我在哪"）
const _p = Astro.url.pathname;
const norm = _p.endsWith('/') ? _p : _p + '/';
const isSec = (slug: string) => norm.startsWith(`/${slug}/`);
const isSub = (slug: string, sub: string) => norm.startsWith(`/${slug}/${sub}/`);

/* Working 板块由 Cloudflare Access（Zero Trust）在边缘鉴权，仓库内不含任何口令。
   此处仅额外声明不被搜索引擎收录，作为纵深防御（见 docs/ACCESS-SETUP.md）。 */
const restricted = norm.startsWith('/working/');
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico?v=2" type="image/x-icon" sizes="16x16 32x32 48x48" />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
  <meta name="theme-color" content="#FAF9F5" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- 非阻塞加载：fonts.googleapis.com 在大陆不可达，阻塞式 <link> 会拖住首屏渲染。
       取不到时回落到本机 Songti SC / PingFang SC（见 --serif / --sans 字体栈），中文照常显示。 -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap"
        rel="stylesheet" media="print" onload="this.media='all';this.onload=null" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" /></noscript>
  {restricted && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>

<header class="cv-site-head" id="cvSiteHead">
  <div class="cv-wrap cv-head-in">
    <a class="cv-brand" href="/">Cavno<span class="cv-bdot">.</span></a>

    <nav class="cv-primary" aria-label="主导航">
      <div class="cv-nav-item">
        <button class:list={['cv-nav-btn', { active: nav.sections.some((s) => isSec(s.slug)) }]} id="cvNav-explore" aria-expanded="false" aria-controls="cvMega-explore">Explore
          <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="cv-mega-panel" id="cvMega-explore" aria-labelledby="cvNav-explore">
          <div class="cv-topic-grid">
            {nav.sections.map((s) => (
              <div class="cv-topic-column">
                <a class:list={['cv-topic-label', { active: isSec(s.slug) }]} href={`/${s.slug}/`}>
                  <span>{s.en}</span><small>{s.zh}</small>
                </a>
                <div class="cv-topic-links">
                  {s.subsections.map((sub) => (
                    <a href={`/${s.slug}/${sub.slug}/`} class:list={{ active: isSub(s.slug, sub.slug) }} aria-current={isSub(s.slug, sub.slug) ? 'page' : undefined}>
                      <span>{sub.en}</span>{sub.zh !== sub.en && <small>{sub.zh}</small>}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      {nav.placeholders.map((item) => <span class="cv-nav-link cv-nav-placeholder" aria-disabled="true">{item.en}</span>)}
    </nav>

    <div class="cv-head-actions">
      <button class="cv-nav-search cv-search-open" type="button" data-cv-search-open aria-label="搜索全站" aria-haspopup="dialog" aria-controls="cvGlobalSearch" aria-expanded="false">
        <span class="cv-search-open-icon" aria-hidden="true"></span>
        <span>Search</span>
      </button>
    </div>

    <button class="cv-burger" id="cvBurger" aria-label="打开菜单" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="cv-drawer" id="cvDrawer" role="dialog" aria-modal="true" aria-label="站点菜单" aria-hidden="true">
  <div class="cv-drawer-top">
    <span class="cv-brand">Cavno<span class="cv-bdot">.</span></span>
    <button class="cv-drawer-close" id="cvDrawerClose" aria-label="关闭菜单">×</button>
  </div>
  <div class:list={['cv-acc', { open: nav.sections.some((s) => isSec(s.slug)) }]}>
    <button class="cv-acc-btn" aria-expanded={nav.sections.some((s) => isSec(s.slug)) ? 'true' : 'false'}>Explore
      <svg class="cv-chev" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
    <div class="cv-acc-body">
      {nav.sections.map((s) => (
        <div class="cv-drawer-group">
          <a class:list={['cv-drawer-group-title', { active: isSec(s.slug) }]} href={`/${s.slug}/`}>{s.en}<small>{s.zh}</small></a>
          {s.subsections.map((sub) => (
            <a class:list={['cv-drawer-entry', { active: isSub(s.slug, sub.slug) }]} href={`/${s.slug}/${sub.slug}/`}>{sub.en}{sub.zh !== sub.en && <small>{sub.zh}</small>}</a>
          ))}
        </div>
      ))}
    </div>
  </div>
  {nav.placeholders.map((item) => (
    <div class="cv-drawer-placeholder" aria-disabled="true">
      <span>{item.en}</span><small>{item.zh} · 待规划</small>
    </div>
  ))}
  <button class="cv-btn cv-btn-line cv-drawer-search" type="button" data-cv-search-open aria-haspopup="dialog" aria-controls="cvGlobalSearch" aria-expanded="false">
    <span class="cv-search-open-icon" aria-hidden="true"></span>
    搜索全站
  </button>
</div>

<GlobalSearch />

<main id="cvMain">
  <slot />
</main>
<footer class="cv-site-foot" id="about">
  <div class="cv-foot-in">
    <div class="cv-foot-grid">
      <div>
        <div class="cv-foot-brand">Cavno<span class="cv-bdot">.</span></div>
        <p class="cv-foot-blurb">一个人的公开工作台：围绕投资、思想、生活与工作，持续整理问题、证据、模型和方法。</p>
      </div>
      {nav.sections.map((s) => (
        <div>
          <h4><a href={`/${s.slug}/`}>{s.en}</a></h4>
          {s.subsections.map((sub) => (
            <a href={`/${s.slug}/${sub.slug}/`}>{sub.en}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="cv-foot-bottom">
      <span>© {year} Cavno · 记录思考，沉淀方法</span>
    </div>
  </div>
</footer>

<script>
  // 顶栏滚动描边
  const head = document.getElementById('cvSiteHead');
  const onScroll = () => head?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 旧内容页里仍有自己的 sticky/fixed 导航。只对真正贴在视口 0 的导航型元素
  // 增加公共顶栏偏移，避免误改表格表头、图表标注等局部吸顶元素。
  const legacyStickySelector = '#cvMain :is(.lp,.sc-article,.tg-article,.wa-article) :is(header,nav,aside,.top,.topbar,.topnav,.sticky,.controls,.rail,.sidebar,.mobile-toc,.fsi-page-nav,.roadmap-nav,#console,#topnav)';
  const syncLegacyStickyOffsets = () => {
    document.querySelectorAll<HTMLElement>(legacyStickySelector).forEach((el) => {
      const style = getComputedStyle(el);
      const top = Number.parseFloat(style.top);
      const shouldOffset = (style.position === 'sticky' || style.position === 'fixed') && Number.isFinite(top) && top <= 1;
      el.classList.toggle('cv-sticky-under-site-head', shouldOffset);
      el.classList.toggle('cv-sticky-viewport-panel', shouldOffset && el.getBoundingClientRect().height >= window.innerHeight - 2);
    });
  };
  let stickySyncFrame = 0;
  const scheduleStickySync = () => {
    cancelAnimationFrame(stickySyncFrame);
    stickySyncFrame = requestAnimationFrame(syncLegacyStickyOffsets);
  };
  scheduleStickySync();
  window.addEventListener('resize', scheduleStickySync, { passive: true });

  // 桌面端多级导航：点击开合，hover / focus-within 由 CSS 处理
  const items = Array.from(document.querySelectorAll('.cv-site-head .cv-nav-item'));
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  let navCloseTimer: ReturnType<typeof setTimeout> | undefined;
  const cancelScheduledClose = () => {
    if (navCloseTimer) window.clearTimeout(navCloseTimer);
    navCloseTimer = undefined;
  };
  const closeAll = () => items.forEach((o) => {
    o.classList.remove('open');
    o.querySelector('.cv-nav-btn')?.setAttribute('aria-expanded', 'false');
  });
  items.forEach((it) => {
    const btn = it.querySelector('.cv-nav-btn');
    const openItem = () => {
      cancelScheduledClose();
      closeAll();
      it.classList.add('open');
      btn?.setAttribute('aria-expanded', 'true');
    };
    it.addEventListener('mouseenter', () => {
      if (finePointer.matches) openItem();
    });
    it.addEventListener('mouseleave', () => {
      if (!finePointer.matches) return;
      cancelScheduledClose();
      navCloseTimer = window.setTimeout(closeAll, 160);
    });
    btn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !it.classList.contains('open');
      cancelScheduledClose();
      closeAll();
      if (willOpen) { it.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
    const panel = it.querySelector('.cv-mega-panel');
    panel?.addEventListener('mouseenter', cancelScheduledClose);
    panel?.addEventListener('click', (e) => e.stopPropagation());
  });
  document.querySelectorAll('.cv-site-head [data-cv-search-open]').forEach((button) => button.addEventListener('click', closeAll));
  document.addEventListener('click', () => { cancelScheduledClose(); closeAll(); });

  // 移动端抽屉
  const cvDrawer = document.getElementById('cvDrawer');
  const cvBurger = document.getElementById('cvBurger');
  const drawerClose = document.getElementById('cvDrawerClose');
  const openDrawer = () => { cvDrawer?.classList.add('open'); cvDrawer?.setAttribute('aria-hidden', 'false'); document.body.classList.add('lock'); cvBurger?.setAttribute('aria-expanded', 'true'); drawerClose?.focus(); };
  const closeDrawer = (restoreFocus = false) => { cvDrawer?.classList.remove('open'); cvDrawer?.setAttribute('aria-hidden', 'true'); document.body.classList.remove('lock'); cvBurger?.setAttribute('aria-expanded', 'false'); if (restoreFocus) cvBurger?.focus(); };
  cvBurger?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', () => closeDrawer(true));
  cvDrawer?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) closeDrawer(); });
  cvDrawer?.querySelector('[data-cv-search-open]')?.addEventListener('click', () => closeDrawer());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeAll(); if (cvDrawer?.classList.contains('open')) closeDrawer(true); }
    if (e.key === 'Tab' && cvDrawer?.classList.contains('open')) {
      const focusable = Array.from(cvDrawer.querySelectorAll<HTMLElement>('button:not([disabled]),a[href]'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
    }
  });
  window.matchMedia('(min-width: 961px)').addEventListener('change', (event) => {
    if (event.matches && cvDrawer?.classList.contains('open')) closeDrawer();
  });

  // 抽屉内手风琴
  document.querySelectorAll('.cv-acc-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.parentElement?.classList.toggle('open') ?? false;
      b.setAttribute('aria-expanded', String(open));
    });
  });
</script>
</body>
</html>
